        0.30790449828673894,-2.9132918265929341E-5,8.3532488641258142E-6,-0.060660620175687734,-3.7638527243085177E-5,
        1.2949735033266653E-5,-0.060348692971084965,0.0,-0.03366968301464044,0.00020190252942289518,0.00010110834451599296,
