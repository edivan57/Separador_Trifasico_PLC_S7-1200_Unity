(*
 * Simulacion_Trifasico_MPC_v8_M6_reducido_S71200.scl
 *
 * MPC REDUCIDO para S7-1200 (CPU 1212C). Base: Simulacion_Trifasico_MPC_v8_M6_it10_opt_S71200_v2.scl
 * (Parametros_MPC_v8: Ts = 0.1 s, P = 200, M = 6, mismos pesos y mismo filtro de Kalman).
 *
 * En la 1212C, el QP con restricciones (19 variables, 72 restricciones, solver KWIK) tardo de
 * 2 a mas de 12 s por ejecucion. Esta version conserva el estimador, el termino lineal del QP y
 * los limites del MPC, pero sustituye el QP por su solucion sin restricciones:
 *     zopt = -Hinv * f   (solo los movimientos u(k) de las 3 valvulas)
 * y despues recorta SIEMPRE con mpc_clipping (cambio por muestra 3.5 / 1.5 / 3 %, apertura 2-99 %).
 *  - Cuando ninguna restriccion esta activa, la accion es la misma que la del MPC completo
 *    (misma cuenta que la rama sin restricciones del QP).
 *  - Cuando hay restricciones activas (valvulas saturadas o limitadas en su cambio), el resultado
 *    puede diferir: el recorte no redistribuye la accion entre valvulas como el QP.
 * Sin QP ya no se usan qr, xgemv, xgerc, DropConstraint, abs_g, b_abs, maximum2, maximum, mtimes,
 * xnrm2, b_norm ni rt_floord: borrarlos del proyecto de TIA despues de importar.
 * LLAMAR DESDE UN OB CICLICO DE 100 ms. Requiere el DB global Diag_HIL.
 * [DIAG] Mediciones de RUNTIME <= 0.0 (vuelta del contador interno) se descartan.
 *)
DATA_BLOCK PLCGlobalVarMPC
STRUCT 
    plc_ts_counter_MPC: DINT;
END_STRUCT
BEGIN
END_DATA_BLOCK
FUNCTION_BLOCK mpc_clipping_MPC
VAR_INPUT
    uk: ARRAY [0..2] OF REAL;
    uk1: ARRAY [0..2] OF REAL;
    b_uoff: ARRAY [0..2] OF REAL;
    b_ny: DINT;
    b_degrees: DINT;
END_VAR
VAR_OUTPUT
    uk_clipped: ARRAY [0..2] OF REAL;
END_VAR
VAR_IN_OUT
    b_Mlim: ARRAY [0..71] OF REAL;   (* solo lectura *)
    b_Mrows: ARRAY [0..71] OF DINT;  (* solo lectura *)
END_VAR
VAR
    nylim: DINT;
    umax: ARRAY [0..2] OF REAL;
    umin: ARRAY [0..2] OF REAL;
    dumin: ARRAY [0..2] OF REAL;
    dumax: ARRAY [0..2] OF REAL;
    iu: DINT;
    du: REAL;
    b_i: DINT;
    tmp: DINT;
    temp1: BOOL;
    temp2: BOOL;
    temp3: BOOL;
END_VAR
nylim := (400 * b_ny) + 1200;
uk_clipped[0] := uk[0];
umax[0] := 3.4028234663852886E+37;
umin[0] := -3.4028234663852886E+37;
dumin[0] := -3.4028234663852886E+37;
dumax[0] := 3.4028234663852886E+37;
uk_clipped[1] := uk[1];
umax[1] := 3.4028234663852886E+37;
umin[1] := -3.4028234663852886E+37;
dumin[1] := -3.4028234663852886E+37;
dumax[1] := 3.4028234663852886E+37;
uk_clipped[2] := uk[2];
umax[2] := 3.4028234663852886E+37;
umin[2] := -3.4028234663852886E+37;
dumin[2] := -3.4028234663852886E+37;
dumax[2] := 3.4028234663852886E+37;
FOR b_i := 0 TO 71 DO 
    iu := b_Mrows[b_i];
    temp1 := FALSE;
    temp2 := FALSE;
    temp3 := FALSE;
    IF iu > (nylim - 1200) THEN 
        IF iu <= (nylim - 1197) THEN 
            iu := (iu - nylim) + 1199;
            umax[iu] := b_Mlim[b_i] + b_uoff[iu];
        ELSE 
            temp3 := TRUE;
        END_IF;
    ELSE 
        temp3 := TRUE;
    END_IF;
    IF temp3 THEN 
        IF iu > (nylim - 600) THEN 
            IF iu <= (nylim - 597) THEN 
                iu := (iu - nylim) + 599;
                umin[iu] := ( -b_Mlim[b_i]) + b_uoff[iu];
            ELSE 
                temp2 := TRUE;
            END_IF;
        ELSE 
            temp2 := TRUE;
        END_IF;
    END_IF;
    IF temp2 THEN 
        IF iu > nylim THEN 
            IF iu <= (nylim + 3) THEN 
                dumax[(iu - nylim) - 1] := b_Mlim[b_i];
            ELSE 
                temp1 := TRUE;
            END_IF;
        ELSE 
            temp1 := TRUE;
        END_IF;
    END_IF;
    IF temp1 THEN 
        tmp := nylim + b_degrees;
        IF iu > (tmp - 1) THEN 
            IF iu <= (tmp + 2) THEN 
                dumin[(iu - nylim) - b_degrees] :=  -b_Mlim[b_i];
            END_IF;
        END_IF;
    END_IF;
END_FOR;
du := uk[0] - uk1[0];
IF du > dumax[0] THEN 
    uk_clipped[0] := uk1[0] + dumax[0];
ELSIF du < dumin[0] THEN 
    uk_clipped[0] := uk1[0] + dumin[0];
END_IF;
IF uk_clipped[0] > umax[0] THEN 
    uk_clipped[0] := umax[0];
ELSIF uk_clipped[0] < umin[0] THEN 
    uk_clipped[0] := umin[0];
END_IF;
du := uk[1] - uk1[1];
IF du > dumax[1] THEN 
    uk_clipped[1] := uk1[1] + dumax[1];
ELSIF du < dumin[1] THEN 
    uk_clipped[1] := uk1[1] + dumin[1];
END_IF;
IF uk_clipped[1] > umax[1] THEN 
    uk_clipped[1] := umax[1];
ELSIF uk_clipped[1] < umin[1] THEN 
    uk_clipped[1] := umin[1];
END_IF;
du := uk[2] - uk1[2];
IF du > dumax[2] THEN 
    uk_clipped[2] := uk1[2] + dumax[2];
ELSIF du < dumin[2] THEN 
    uk_clipped[2] := uk1[2] + dumin[2];
END_IF;
IF uk_clipped[2] > umax[2] THEN 
    uk_clipped[2] := umax[2];
ELSIF uk_clipped[2] < umin[2] THEN 
    uk_clipped[2] := umin[2];
END_IF;
END_FUNCTION_BLOCK
FUNCTION_BLOCK mpcblock_refmd_MPC
VAR_INPUT
    b_ref: ARRAY [0..2] OF REAL;
    b_yoff: ARRAY [0..2] OF REAL;
    b_RYscale: ARRAY [0..2] OF REAL;
END_VAR
VAR_OUTPUT
    rseq: ARRAY [0..2] OF REAL;   (* antes 0..599: solo se usan rseq[0..2] *)
    v: REAL;
END_VAR
VAR
    b_i: DINT;
    ref_0: REAL;
    ref_1: REAL;
    ref_2: REAL;
    b_RYscale_0: REAL;
    b_RYscale_1: REAL;
    b_RYscale_2: REAL;
    b_yoff_0: REAL;
    b_yoff_1: REAL;
    b_yoff_2: REAL;
END_VAR
ref_0 := b_ref[0];
ref_1 := b_ref[1];
ref_2 := b_ref[2];
b_RYscale_0 := b_RYscale[0];
b_RYscale_1 := b_RYscale[1];
b_RYscale_2 := b_RYscale[2];
b_yoff_0 := b_yoff[0];
b_yoff_1 := b_yoff[1];
b_yoff_2 := b_yoff[2];
FOR b_i := 0 TO 0 DO    (* solo rseq[0..2] se usa *)
    rseq[b_i * 3] := (ref_0 * b_RYscale_0) - b_yoff_0;
    rseq[(b_i * 3) + 1] := (ref_1 * b_RYscale_1) - b_yoff_1;
    rseq[(b_i * 3) + 2] := (ref_2 * b_RYscale_2) - b_yoff_2;
END_FOR;
v := 1.0;
END_FUNCTION_BLOCK
FUNCTION_BLOCK MPC_Control
VAR_INPUT
    ssMethodType: INT;
    moorx: ARRAY [0..2] OF REAL;
    b_ref: ARRAY [0..2] OF REAL;
