 * Model last modified on          : Mon Sep 21 16:20:13 2026
 * Model sample time               : 0.01s
 * Subsystem name                  : Simulacion_Trifasico_PID_v8/PID_
 * Subsystem sample time           : 0.01s
 * Simulink PLC Coder version      : 24.1 (R2024a) 19-Nov-2023
 * ST code generated on            : Mon Sep 21 16:21:07 2026
 *
 * Target IDE selection            : Siemens TIA Portal
 * Test Bench included             : No
 *
 * MODIFICADO: instrumentacion de tiempo con RUNTIME (lineas marcadas [DIAG]).
 *  - Mide solo las ejecuciones en que se calcula la ley de control
 *    (plc_ts_counter_pid = 0), asi el divisor 1:10 no diluye el promedio.
 *  - Requiere el DB global Diag_HIL (Diag_HIL.scl) en el proyecto.
 *  - La ley de control no cambia.
  * [DIAG] Mediciones de RUNTIME <= 0.0 (vuelta del contador interno) se descartan.
 * Divisor 1:10 desactivado: la ley se ejecuta en cada llamada del OB32 (100 ms).
*)
DATA_BLOCK PLCGlobalVar_PID
STRUCT 
    plc_ts_counter_pid: DINT;
END_STRUCT
BEGIN
END_DATA_BLOCK
FUNCTION_BLOCK PID_Control
VAR_INPUT
    ssMethodType: INT;
    b_ref: ARRAY [0..2] OF REAL;
    y: ARRAY [0..2] OF REAL;
END_VAR
VAR_OUTPUT
    mv: ARRAY [0..2] OF REAL;
END_VAR
VAR
    c_inicializado_not_e: BOOL;
    b_u: ARRAY [0..2] OF REAL;
    last_mv: ARRAY [0..2] OF REAL;
    e2: ARRAY [0..2] OF REAL;
    e1: ARRAY [0..2] OF REAL;
    b_d: REAL;
    e: REAL;
    u: REAL;
END_VAR
CASE ssMethodType OF
    0: 
        PLCGlobalVar_PID.plc_ts_counter_pid := 0;
        (* SystemInitialize for Atomic SubSystem: '<Root>/PID_' *)
        (* SystemInitialize for MATLAB Function: '<S1>/MATLAB Function8' *)
        c_inicializado_not_e := FALSE;
        (* End of SystemInitialize for SubSystem: '<Root>/PID_' *)
    1: 
        IF PLCGlobalVar_PID.plc_ts_counter_pid = 0 THEN 
            (* [DIAG] inicio de la medicion *)
            "Diag_HIL".pid_aux := RUNTIME("Diag_HIL".pid_mem);
            
            (* Outputs for Atomic SubSystem: '<Root>/PID_' *)
            (* MATLAB Function: '<S1>/MATLAB Function8' *)
            (* ========================================================== *)
            (* PID DISCRETO TPSEP - v8 (simplificada) *)
            
            (* u(k) = u(k-1) + q0*e(k) + q1*e(k-1) + q2*e(k-2) *)
            
            (* q0 =  Kp*( 1 + Ts/(2*Ti) +   Td/Ts ) *)
            (* q1 = -Kp*( 1 - Ts/(2*Ti) + 2*Td/Ts ) *)
            (* q2 =  Kp*Td/Ts *)
            
            (* La salida u ES la apertura de valvula, saturada en [0.01, 0.99]. *)
            (* Las tres valvulas son de SALIDA (abrir hace BAJAR la PV), por eso *)
            (* el error se toma como e = y - ref (accion inversa). *)
            
            (* Entradas: ref = [hw_sp; hb_sp; pg_sp], y = [hw; hb; pg], reset *)
            (* Salida:   mv  = [vpw; vpc; vpg] *)
            (* ========================================================== *)
            (* MATLAB Function 'PID_/MATLAB Function8': '<S2>:1' *)
            (* '<S2>:1:20' Ts = 0.1; *)
            (* [s] periodo de ejecucion real *)
            (* ========================================================== *)
            (* SINTONIA   (zeta ~ 0.5  ->  sobrepico ~16%) *)
            (* ========================================================== *)
            (* hw       hb       pg *)
            (* '<S2>:1:26' Kp = [  53.93;  14.395;   2.673]; *)
            (* antes 38.52 y 8.941 *)
            (* '<S2>:1:27' Ti = [   7.821;  2.702;   1.050]; *)
            (* antes 10.95 y 4.350 *)
            (* '<S2>:1:29' Td = [   0.00;   0.000;   0.000]; *)
            (* ========================================================== *)
            (* LIMITES Y ARRANQUE *)
            (* ========================================================== *)
            (* '<S2>:1:34' mv_min   = 0.01; *)
            (* '<S2>:1:35' mv_max   = 0.99; *)
            (* '<S2>:1:36' rate_max = [0.030; 0.030; 0.030]; *)
            (* por llamada = 0.30 /s con Ts = 0.1 *)
            (* '<S2>:1:37' mv0      = [0.6846; 0.2532; 0.4889]; *)
            (* aperturas de equilibrio *)
            (* ========================================================== *)
            (* COEFICIENTES *)
            (* ========================================================== *)
            (* '<S2>:1:42' q0 =  Kp .* (1.0 + Ts./(2.0.*Ti) +       Td./Ts); *)
            (* '<S2>:1:43' q1 = -Kp .* (1.0 - Ts./(2.0.*Ti) + 2.0.*Td./Ts); *)
            (* '<S2>:1:44' q2 =  Kp .*  Td ./ Ts; *)
            (* ========================================================== *)
            (* MEMORIAS *)
            (* ========================================================== *)
            (* '<S2>:1:51' if isempty(inicializado) || reset ~= 0 *)
            IF  NOT c_inicializado_not_e THEN 
                (* '<S2>:1:52' e1 = zeros(3,1); *)
                (* '<S2>:1:53' e2 = zeros(3,1); *)
                (* '<S2>:1:54' u  = mv0; *)
                (* '<S2>:1:55' last_mv = mv0; *)
                e1[0] := 0.0;
                b_u[0] := 0.6846;
                last_mv[0] := 0.6846;
                e1[1] := 0.0;
                b_u[1] := 0.2532;
                last_mv[1] := 0.2532;
                e1[2] := 0.0;
                b_u[2] := 0.4889;
                last_mv[2] := 0.4889;
                (* '<S2>:1:56' inicializado = true; *)
                c_inicializado_not_e := TRUE;
            END_IF;
            (* End of Outputs for SubSystem: '<Root>/PID_' *)
            (* ========================================================== *)
            (* LEY DE CONTROL *)
            (* ========================================================== *)
            (* '<S2>:1:62' e = y(:) - ref(:); *)
            (* accion inversa *)
            (* '<S2>:1:64' u = u + q0.*e + q1.*e1 + q2.*e2; *)
            (* '<S2>:1:66' for i = 1:3 *)
            (* ========================================================== *)
            (* LIMITADOR DE VELOCIDAD *)
            (* ========================================================== *)
            (* '<S2>:1:77' mv = u; *)
            (* Outputs for Atomic SubSystem: '<Root>/PID_' *)
            (* MATLAB Function: '<S1>/MATLAB Function8' *)
            (* '<S2>:1:78' for i = 1:3 *)
            (* '<S2>:1:87' last_mv = mv; *)
            (* '<S2>:1:88' e2 = e1; *)
            (* '<S2>:1:89' e1 = e; *)
            e := y[0] - b_ref[0];
            u := ((54.27477688275156 * e) + b_u[0]) + (-53.585223117248432 * e1[0]);
            b_u[0] := u;
            (* saturacion con memoria saturada *)
            (* '<S2>:1:67' if u(i) > mv_max *)
            IF u > 0.99 THEN 
                (* (anti-windup de la forma incremental) *)
                (* '<S2>:1:68' u(i) = mv_max; *)
                u := 0.99;
                b_u[0] := 0.99;
            ELSIF u < 0.01 THEN 
                (* '<S2>:1:69' elseif u(i) < mv_min *)
                (* '<S2>:1:70' u(i) = mv_min; *)
                u := 0.01;
                b_u[0] := 0.01;
            END_IF;
            mv[0] := u;
            (* '<S2>:1:79' d = u(i) - last_mv(i); *)
            b_d := u - last_mv[0];
            (* '<S2>:1:80' if d > rate_max(i) *)
            IF b_d > 0.03 THEN 
                (* '<S2>:1:81' mv(i) = last_mv(i) + rate_max(i); *)
                u := last_mv[0] + 0.03;
                mv[0] := last_mv[0] + 0.03;
            ELSIF b_d < -0.03 THEN 
                (* '<S2>:1:82' elseif d < -rate_max(i) *)
                (* '<S2>:1:83' mv(i) = last_mv(i) - rate_max(i); *)
                u := last_mv[0] - 0.03;
                mv[0] := last_mv[0] - 0.03;
            END_IF;
            last_mv[0] := u;
            e2[0] := e1[0];
            e1[0] := e;
            e := y[1] - b_ref[1];
            u := ((14.661376757957068 * e) + b_u[1]) + (-14.128623242042931 * e1[1]);
            b_u[1] := u;
            (* saturacion con memoria saturada *)
            (* '<S2>:1:67' if u(i) > mv_max *)
            IF u > 0.99 THEN 
                (* (anti-windup de la forma incremental) *)
                (* '<S2>:1:68' u(i) = mv_max; *)
                u := 0.99;
                b_u[1] := 0.99;
            ELSIF u < 0.01 THEN 
                (* '<S2>:1:69' elseif u(i) < mv_min *)
                (* '<S2>:1:70' u(i) = mv_min; *)
                u := 0.01;
                b_u[1] := 0.01;
            END_IF;
            mv[1] := u;
            (* '<S2>:1:79' d = u(i) - last_mv(i); *)
            b_d := u - last_mv[1];
            (* '<S2>:1:80' if d > rate_max(i) *)
            IF b_d > 0.03 THEN 
                (* '<S2>:1:81' mv(i) = last_mv(i) + rate_max(i); *)
                u := last_mv[1] + 0.03;
                mv[1] := last_mv[1] + 0.03;
            ELSIF b_d < -0.03 THEN 
                (* '<S2>:1:82' elseif d < -rate_max(i) *)
                (* '<S2>:1:83' mv(i) = last_mv(i) - rate_max(i); *)
                u := last_mv[1] - 0.03;
                mv[1] := last_mv[1] - 0.03;
            END_IF;
            last_mv[1] := u;
            e2[1] := e1[1];
            e1[1] := e;
            e := y[2] - b_ref[2];
            u := ((2.8002857142857143 * e) + b_u[2]) + (-2.5457142857142858 * e1[2]);
            b_u[2] := u;
            (* saturacion con memoria saturada *)
            (* '<S2>:1:67' if u(i) > mv_max *)
            IF u > 0.99 THEN 
                (* (anti-windup de la forma incremental) *)
                (* '<S2>:1:68' u(i) = mv_max; *)
                u := 0.99;
                b_u[2] := 0.99;
            ELSIF u < 0.01 THEN 
                (* '<S2>:1:69' elseif u(i) < mv_min *)
                (* '<S2>:1:70' u(i) = mv_min; *)
                u := 0.01;
                b_u[2] := 0.01;
            END_IF;
            mv[2] := u;
            (* '<S2>:1:79' d = u(i) - last_mv(i); *)
            b_d := u - last_mv[2];
            (* '<S2>:1:80' if d > rate_max(i) *)
            IF b_d > 0.03 THEN 
                (* '<S2>:1:81' mv(i) = last_mv(i) + rate_max(i); *)
                u := last_mv[2] + 0.03;
                mv[2] := last_mv[2] + 0.03;
            ELSIF b_d < -0.03 THEN 
                (* '<S2>:1:82' elseif d < -rate_max(i) *)
                (* '<S2>:1:83' mv(i) = last_mv(i) - rate_max(i); *)
                u := last_mv[2] - 0.03;
                mv[2] := last_mv[2] - 0.03;
            END_IF;
            last_mv[2] := u;
            e2[2] := e1[2];
            e1[2] := e;
            (* End of Outputs for SubSystem: '<Root>/PID_' *)
            
            (* [DIAG] fin de la medicion: tiempo de esta ejecucion en ms *)
            "Diag_HIL".pid_ms := RUNTIME("Diag_HIL".pid_mem) * 1000.0;
            
            (* [DIAG] reinicio de estadisticas desde la tabla de observacion *)
            IF "Diag_HIL".pid_reset THEN
                "Diag_HIL".pid_n := 0;
                "Diag_HIL".pid_sum_ms := 0.0;
                "Diag_HIL".pid_max_ms := 0.0;
                "Diag_HIL".pid_reset := FALSE;
            END_IF;
            
            (* [DIAG] promedio y maximo desde el ultimo reset *)
            (* [DIAG] Si el contador interno de RUNTIME da la vuelta, la medicion sale <= 0.0 y
               Siemens indica descartarla: solo se acumulan mediciones positivas. *)
            IF "Diag_HIL".pid_ms > 0.0 THEN
                "Diag_HIL".pid_n := "Diag_HIL".pid_n + 1;
                "Diag_HIL".pid_sum_ms := "Diag_HIL".pid_sum_ms + "Diag_HIL".pid_ms;
                "Diag_HIL".pid_prom_ms := "Diag_HIL".pid_sum_ms / DINT_TO_LREAL("Diag_HIL".pid_n);
                "Diag_HIL".pid_max_ms := MAX(IN1 := "Diag_HIL".pid_max_ms, IN2 := "Diag_HIL".pid_ms);
            END_IF;
        END_IF;
        (* Divisor 1:10 de PLC Coder DESACTIVADO (>= 0): la ley se calcula en cada    *)
        (* llamada. LLAMAR DESDE UN OB CICLICO DE 100 ms, igual que el Fuzzy y el MPC. *)
        IF PLCGlobalVar_PID.plc_ts_counter_pid >= 0 THEN 
            PLCGlobalVar_PID.plc_ts_counter_pid := 0;
        ELSE 
            PLCGlobalVar_PID.plc_ts_counter_pid := PLCGlobalVar_PID.plc_ts_counter_pid + 1;
        END_IF;
END_CASE;
END_FUNCTION_BLOCK
