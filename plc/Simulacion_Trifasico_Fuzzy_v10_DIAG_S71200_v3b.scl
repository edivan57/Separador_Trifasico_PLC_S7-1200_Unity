        2,3,4,5,6,7,8,3,4,5,6,7,8,9,4,5,6,7,8,9,9,5,6,7,8,9,9,9];
    (* parametros [a b c] de las 9 funciones triangulares de salida, en orden NGG..PGG *)
    MFsal: ARRAY [0..26] OF REAL := [-1.0,-1.0,-0.75,-1.0,-0.75,-0.5,-0.75,-0.5,-0.25,-0.5,-0.25,0.0,-0.25,0.0,0.25,
        0.0,0.25,0.5,0.25,0.5,0.75,0.5,0.75,1.0,0.75,1.0,1.0];
    cacheMF_ok: BOOL := FALSE;
    mfID: DINT;
    MFini: ARRAY [0..8] OF DINT;    (* primer punto con valor > 0 de cada funcion de salida *)
    MFfin: ARRAY [0..8] OF DINT;    (* ultimo punto con valor > 0 de cada funcion de salida *)
    actRule: ARRAY [0..146] OF DINT;   (* reglas activas del ciclo, en orden creciente *)
    nAct: DINT;
    kAct: DINT;
    lazo: DINT;
    iMF: DINT;
    jMF: DINT;
    aggIni: ARRAY [0..2] OF DINT;   (* rango de puntos con agregacion posible por salida *)
    aggFin: ARRAY [0..2] OF DINT;
