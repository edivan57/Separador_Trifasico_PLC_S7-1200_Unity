
DATA_BLOCK PLCGlobalVar_FUZZY
STRUCT 
    plc_ts_counter_fuzzy: DINT;
END_STRUCT
BEGIN
END_DATA_BLOCK
FUNCTION_BLOCK trimf_o_FUZZY
VAR_INPUT
    params: ARRAY [0..2] OF REAL;
END_VAR
VAR_OUTPUT
    y: ARRAY [0..100] OF REAL;
END_VAR
VAR_IN_OUT
    x: ARRAY [0..100] OF REAL;   (* solo lectura, por referencia *)
END_VAR
VAR
    a: REAL;
    b_b: REAL;
    b_c: REAL;
    b_i: DINT;
    x_0: REAL;
END_VAR
a := params[0];
b_b := params[1];
b_c := params[2];
FOR b_i := 0 TO 100 DO 
    y[b_i] := 0.0;
    IF a <> b_b THEN 
        x_0 := x[b_i];
        IF a < x_0 THEN 
            IF x_0 < b_b THEN 
                y[b_i] := (1.0 / (b_b - a)) * (x_0 - a);
            END_IF;
        END_IF;
    END_IF;
    IF b_b <> b_c THEN 
        x_0 := x[b_i];
        IF b_b < x_0 THEN 
            IF x_0 < b_c THEN 
                y[b_i] := (1.0 / (b_c - b_b)) * (b_c - x_0);
            END_IF;
        END_IF;
    END_IF;
    IF x[b_i] = b_b THEN 
        y[b_i] := 1.0;
    END_IF;
END_FOR;
END_FUNCTION_BLOCK
FUNCTION trapmf_FUZZY: REAL
VAR_INPUT
    x: REAL;
    params: ARRAY [0..3] OF REAL;
END_VAR
VAR_TEMP
    b_x: REAL;
    b_y: REAL;
END_VAR
b_x := 0.0;
b_y := 0.0;
IF x >= params[1] THEN 
    b_x := 1.0;
END_IF;
IF x < params[0] THEN 
    b_x := 0.0;
END_IF;
IF params[0] <= x THEN 
    IF x < params[1] THEN 
        IF params[0] <> params[1] THEN 
            b_x := (1.0 / (params[1] - params[0])) * (x - params[0]);
        END_IF;
    END_IF;
END_IF;
IF x <= params[2] THEN 
    b_y := 1.0;
END_IF;
IF x > params[3] THEN 
    b_y := 0.0;
END_IF;
IF params[2] < x THEN 
    IF x <= params[3] THEN 
        IF params[2] <> params[3] THEN 
            b_y := (1.0 / (params[3] - params[2])) * (params[3] - x);
        END_IF;
    END_IF;
END_IF;
trapmf_FUZZY := MIN(IN1:=b_x, IN2:=b_y);
END_FUNCTION
FUNCTION trimf_FUZZY: REAL
VAR_INPUT
    x: REAL;
    params: ARRAY [0..2] OF REAL;
END_VAR
trimf_FUZZY := 0.0;
IF params[0] <> params[1] THEN 
    IF params[0] < x THEN 
        IF x < params[1] THEN 
            trimf_FUZZY := (1.0 / (params[1] - params[0])) * (x - params[0]);
        END_IF;
    END_IF;
END_IF;
IF params[1] <> params[2] THEN 
    IF params[1] < x THEN 
        IF x < params[2] THEN 
            trimf_FUZZY := (1.0 / (params[2] - params[1])) * (params[2] - x);
        END_IF;
    END_IF;
END_IF;
IF x = params[1] THEN 
    trimf_FUZZY := 1.0;
END_IF;
END_FUNCTION
