    e_idx_1: REAL;
    rtb_xin_idx_2: REAL;
    de_idx_1: REAL;
    rtb_xin_idx_3: REAL;
    rtb_xin_idx_4: REAL;
    de_idx_2: REAL;
    rtb_xin_idx_5: REAL;
    d_rtb_aggregatedOutp: DINT;
END_VAR
CASE ssMethodType OF
    0: 
        PLCGlobalVar_FUZZY.plc_ts_counter_fuzzy := 0;
        (* SystemInitialize for Atomic SubSystem: '<Root>/Fuzzy_' *)
        (* SystemInitialize for MATLAB Function: '<S1>/MATLAB Function8' *)
        c_initialized_not_em := FALSE;
        (* SystemInitialize for MATLAB Function: '<S1>/MATLAB Function7' *)
        d_initialized_not_em := FALSE;
        (* End of SystemInitialize for SubSystem: '<Root>/Fuzzy_' *)
    1: 
        IF PLCGlobalVar_FUZZY.plc_ts_counter_fuzzy = 0 THEN 
            (* [DIAG] inicio de la medicion *)
            "Diag_HIL".fuzzy_aux := RUNTIME("Diag_HIL".fuzzy_mem);
            
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* MATLAB Function: '<S1>/MATLAB Function8' *)
            (* Preprocesamiento del controlador fuzzy MIMO (replica main_Fuzzy_2.m). *)
            
            (* ref = [hw_sp; hb_sp; pg_sp]    y = [hw; hb; pg] *)
            (* xin = [e_hw; de_hw; e_hb; de_hb; e_pg; de_pg]  -> FIS de 6 entradas *)
            
            (* Puerto reset: 0 = operacion normal, distinto de 0 = reinicia estados. *)
            (* MATLAB Function 'Fuzzy_/MATLAB Function8': '<S4>:1' *)
            (* ---------------- Escalas de entrada al FIS ---------------- *)
            (* hw     hb     pg *)
            (* '<S4>:1:12' Ke  = [  0.30;  0.60;  0.09]; *)
            (* escala del error *)
            (* '<S4>:1:13' Kde = [ 22.00; 12.00;  3.00]; *)
            (* escala de la derivada *)
            (* NOTA: en el lazo de gas Kde/Ke = 100, asi que el canal derivativo pesa *)
            (* mas que el del error (medido: 1.4x durante los transitorios). Es la *)
            (* entrada mas sensible al periodo real de ejecucion. Si reaparece el *)
            (* chattering de vpg, bajar Kde(3) de 6.0 a 2.0 es la correccion de fondo. *)
            (* ---------------- Estados persistentes ---------------- *)
            (* '<S4>:1:23' if isempty(initialized) || reset ~= 0 *)
            IF  NOT c_initialized_not_em THEN 
                (* '<S4>:1:24' e_ant = zeros(3,1); *)
                e_ant[0] := 0.0;
                e_ant[1] := 0.0;
                e_ant[2] := 0.0;
                (* '<S4>:1:25' initialized = true; *)
                c_initialized_not_em := TRUE;
            END_IF;
            (* ---------------- Error (PV - SP) ---------------- *)
            (* '<S4>:1:29' e = y(:) - ref(:); *)
            (* ---------------- Derivada discreta (por muestra) ---------------- *)
            (* '<S4>:1:32' de    = e - e_ant; *)
            (* '<S4>:1:33' e_ant = e; *)
            e := y[0] - b_ref[0];
            e_idx_0 := e;
            de_idx_0 := e - e_ant[0];
            e_ant[0] := e;
            e := y[1] - b_ref[1];
            e_idx_1 := e;
            de_idx_1 := e - e_ant[1];
            e_ant[1] := e;
            e := y[2] - b_ref[2];
            de_idx_2 := e - e_ant[2];
            e_ant[2] := e;
            (* ---------------- Escalamiento ---------------- *)
            (* '<S4>:1:36' xin = zeros(6,1); *)
            (* '<S4>:1:37' xin(1) = e(1)*Ke(1); *)
            mfVal := e_idx_0 * 0.3;
            (* '<S4>:1:37' xin(2) = de(1)*Kde(1); *)
            area := de_idx_0 * 22.0;
            (* '<S4>:1:38' xin(3) = e(2)*Ke(2); *)
            rtb_xin_idx_2 := e_idx_1 * 0.6;
            (* '<S4>:1:38' xin(4) = de(2)*Kde(2); *)
            rtb_xin_idx_3 := de_idx_1 * 12.0;
            (* '<S4>:1:39' xin(5) = e(3)*Ke(3); *)
            rtb_xin_idx_4 := e * 0.09;
            (* '<S4>:1:39' xin(6) = de(3)*Kde(3); *)
            rtb_xin_idx_5 := de_idx_2 * 3.0;
            (* End of MATLAB Function: '<S1>/MATLAB Function8' *)
            
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            (* ---------------- Saturacion de las entradas del FIS ---------------- *)
            (* DESACTIVADA para replicar el script: evalfis no satura, y si una entrada *)
            (* sale de [-1,1] ninguna MF dispara y el FIS devuelve el punto medio (0). *)
            (* El bloque Fuzzy Logic Controller y su codigo generado hacen lo mismo. *)
            (* '<S4>:1:45' SAT_XIN = false; *)
            (* '<S4>:1:47' if SAT_XIN *)
            (* MATLAB Function 'Evaluate Rule Antecedents': '<S6>:1' *)
            (* '<S6>:1:4' if SimulateUsing==1 && coder.internal.canUseExtrinsic ... *)
            (* '<S6>:1:5'         && (isa(inputs,'double') || isa(inputs,'single')) *)
            (* '<S6>:1:32' else *)
            (* '<S6>:1:33' if fis.inputFuzzySetType==1 *)
            (* '<S6>:1:34' [antecedentOutputs,sumAntecedentOutputs] = ... *)
            (* '<S6>:1:35'             fuzzy.internal.codegen.evaluateRuleAntecedent(... *)
            (* '<S6>:1:36'             inputs,fis,diagnostics); *)
            e := 0.0;
            inputMFCache[0] := trapmf_FUZZY(x := mfVal, params := f);
            inputMFCache[1] := trimf_FUZZY(x := mfVal, params := b_e);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.6;
            tmp[1] := -0.3;
            tmp[2] := 0.0;
            inputMFCache[2] := trimf_FUZZY(x := mfVal, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.3;
            tmp[1] := 0.0;
            tmp[2] := 0.3;
            inputMFCache[3] := trimf_FUZZY(x := mfVal, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := 0.0;
            tmp[1] := 0.3;
            tmp[2] := 0.6;
            inputMFCache[4] := trimf_FUZZY(x := mfVal, params := tmp);
            inputMFCache[5] := trimf_FUZZY(x := mfVal, params := c_d);
            inputMFCache[6] := trapmf_FUZZY(x := mfVal, params := b_c);
            inputMFCache[7] := trapmf_FUZZY(x := area, params := f);
            inputMFCache[8] := trimf_FUZZY(x := area, params := b_e);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.6;
            tmp[1] := -0.3;
            tmp[2] := 0.0;
            inputMFCache[9] := trimf_FUZZY(x := area, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.3;
            tmp[1] := 0.0;
            tmp[2] := 0.3;
            inputMFCache[10] := trimf_FUZZY(x := area, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := 0.0;
            tmp[1] := 0.3;
            tmp[2] := 0.6;
            inputMFCache[11] := trimf_FUZZY(x := area, params := tmp);
            inputMFCache[12] := trimf_FUZZY(x := area, params := c_d);
            inputMFCache[13] := trapmf_FUZZY(x := area, params := b_c);
            inputMFCache[14] := trapmf_FUZZY(x := rtb_xin_idx_2, params := f);
            inputMFCache[15] := trimf_FUZZY(x := rtb_xin_idx_2, params := b_e);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.6;
            tmp[1] := -0.3;
            tmp[2] := 0.0;
            inputMFCache[16] := trimf_FUZZY(x := rtb_xin_idx_2, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.3;
            tmp[1] := 0.0;
            tmp[2] := 0.3;
            inputMFCache[17] := trimf_FUZZY(x := rtb_xin_idx_2, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := 0.0;
            tmp[1] := 0.3;
            tmp[2] := 0.6;
            inputMFCache[18] := trimf_FUZZY(x := rtb_xin_idx_2, params := tmp);
            inputMFCache[19] := trimf_FUZZY(x := rtb_xin_idx_2, params := c_d);
            inputMFCache[20] := trapmf_FUZZY(x := rtb_xin_idx_2, params := b_c);
            inputMFCache[21] := trapmf_FUZZY(x := rtb_xin_idx_3, params := f);
            inputMFCache[22] := trimf_FUZZY(x := rtb_xin_idx_3, params := b_e);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.6;
            tmp[1] := -0.3;
            tmp[2] := 0.0;
            inputMFCache[23] := trimf_FUZZY(x := rtb_xin_idx_3, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.3;
            tmp[1] := 0.0;
            tmp[2] := 0.3;
            inputMFCache[24] := trimf_FUZZY(x := rtb_xin_idx_3, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := 0.0;
            tmp[1] := 0.3;
            tmp[2] := 0.6;
            inputMFCache[25] := trimf_FUZZY(x := rtb_xin_idx_3, params := tmp);
            inputMFCache[26] := trimf_FUZZY(x := rtb_xin_idx_3, params := c_d);
            inputMFCache[27] := trapmf_FUZZY(x := rtb_xin_idx_3, params := b_c);
            inputMFCache[28] := trapmf_FUZZY(x := rtb_xin_idx_4, params := f);
            inputMFCache[29] := trimf_FUZZY(x := rtb_xin_idx_4, params := b_e);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.6;
            tmp[1] := -0.3;
            tmp[2] := 0.0;
            inputMFCache[30] := trimf_FUZZY(x := rtb_xin_idx_4, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.3;
            tmp[1] := 0.0;
            tmp[2] := 0.3;
            inputMFCache[31] := trimf_FUZZY(x := rtb_xin_idx_4, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := 0.0;
            tmp[1] := 0.3;
            tmp[2] := 0.6;
            inputMFCache[32] := trimf_FUZZY(x := rtb_xin_idx_4, params := tmp);
            inputMFCache[33] := trimf_FUZZY(x := rtb_xin_idx_4, params := c_d);
            inputMFCache[34] := trapmf_FUZZY(x := rtb_xin_idx_4, params := b_c);
            inputMFCache[35] := trapmf_FUZZY(x := rtb_xin_idx_5, params := f);
            inputMFCache[36] := trimf_FUZZY(x := rtb_xin_idx_5, params := b_e);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.6;
            tmp[1] := -0.3;
            tmp[2] := 0.0;
            inputMFCache[37] := trimf_FUZZY(x := rtb_xin_idx_5, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := -0.3;
            tmp[1] := 0.0;
            tmp[2] := 0.3;
            inputMFCache[38] := trimf_FUZZY(x := rtb_xin_idx_5, params := tmp);
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            tmp[0] := 0.0;
            tmp[1] := 0.3;
            tmp[2] := 0.6;
            inputMFCache[39] := trimf_FUZZY(x := rtb_xin_idx_5, params := tmp);
            inputMFCache[40] := trimf_FUZZY(x := rtb_xin_idx_5, params := c_d);
            inputMFCache[41] := trapmf_FUZZY(x := rtb_xin_idx_5, params := b_c);
            (* Antecedentes. Cada entrada tiene a lo sumo 2 funciones de pertenencia distintas de cero,
               asi que hay a lo sumo 4 reglas activas por lazo: la regla 49*lazo + 7*(i-1) + (j-1) usa la
               funcion i del error y la j de su variacion. Solo esas se calculan, con la misma secuencia
               de minimos del original; las demas valen 0.0, que es lo que da el original para ellas. *)
            (* Solo se ponen en 0 las reglas que quedaron activas en el ciclo anterior; las demas ya valen 0 *)
            FOR kAct := 0 TO nAct - 1 DO 
                c_rtb_antecedentOutp[actRule[kAct]] := 0.0;
            END_FOR;
            nAct := 0;
            FOR lazo := 0 TO 2 DO 
                FOR iMF := 1 TO 7 DO 
                    IF inputMFCache[((7 * (2 * lazo)) + iMF) - 1] <> 0.0 THEN 
                        FOR jMF := 1 TO 7 DO 
                            IF inputMFCache[((7 * ((2 * lazo) + 1)) + jMF) - 1] <> 0.0 THEN 
                                ruleID := ((49 * lazo) + (7 * (iMF - 1))) + (jMF - 1);
                                c_rtb_antecedentOutp[ruleID] := 1.0;
                                area := inputMFCache[((7 * (2 * lazo)) + iMF) - 1];
                                IF c_rtb_antecedentOutp[ruleID] > area THEN 
                                    c_rtb_antecedentOutp[ruleID] := area;
                                END_IF;
                                area := inputMFCache[((7 * ((2 * lazo) + 1)) + jMF) - 1];
                                IF c_rtb_antecedentOutp[ruleID] > area THEN 
                                    c_rtb_antecedentOutp[ruleID] := area;
                                END_IF;
                                actRule[nAct] := ruleID;
                                nAct := nAct + 1;
                            END_IF;
                        END_FOR;
                    END_IF;
                END_FOR;
            END_FOR;
            (* Suma de activaciones en orden creciente de regla; las reglas inactivas suman 0.0 *)
            FOR kAct := 0 TO nAct - 1 DO 
                e := e + c_rtb_antecedentOutp[actRule[kAct]];
            END_FOR;
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* MATLAB Function 'Evaluate Rule Consequents': '<S7>:1' *)
            (* '<S7>:1:4' if SimulateUsing==1 && coder.internal.canUseExtrinsic ... *)
            (* '<S7>:1:5'         && (isa(inputs,'double') || isa(inputs,'single')) *)
            (* '<S7>:1:55' else *)
            (* '<S7>:1:56' if fis.inputFuzzySetType==1 *)
            (* '<S7>:1:57' if strcmp(char(fis.type),'mamdani') *)
            (* '<S7>:1:58' aggregatedOutputs = ... *)
            (* '<S7>:1:59'                 fuzzy.internal.codegen.evaluateRuleConsequentForMamdaniFIS(... *)
            (* '<S7>:1:60'                 antecedentOutputs,fis,samplePoints); *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Consequents' *)
            (* Solo los rangos que la agregacion pudo cambiar en el ciclo anterior; el resto ya vale 0 *)
            FOR inputID := 0 TO 2 DO 
                FOR sampleID := aggIni[inputID] TO aggFin[inputID] DO 
                    c_rtb_aggregatedOutp[(101 * inputID) + sampleID] := 0.0;
                END_FOR;
            END_FOR;
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* Outputs for Atomic SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            (* MATLAB Function: '<S2>/Evaluate Rule Consequents' incorporates:
             *  Constant: '<S2>/Output Sample Points' *)
            (* Funciones de pertenencia de salida evaluadas en los 101 puntos. Dependen solo de
               constantes y las tres salidas comparten funciones y puntos: se calculan una vez
               (9 x 101 valores) con el mismo trimf_o_FUZZY y los mismos operandos que el original. *)
            IF NOT cacheMF_ok THEN 
                FOR mfID := 0 TO 8 DO 
                    tmp[0] := MFsal[3 * mfID];
                    tmp[1] := MFsal[(3 * mfID) + 1];
                    tmp[2] := MFsal[(3 * mfID) + 2];
                    i0_trimf_o(x := c_OutputSamplePoints, params := tmp);
                    FOR b_i := 0 TO 100 DO 
                        outputMFCache[(9 * b_i) + mfID] := i0_trimf_o.y[b_i];
                    END_FOR;
                    (* Rango de puntos donde la funcion es mayor que 0; fuera de el la regla no aporta nada *)
                    MFini[mfID] := 101;
                    MFfin[mfID] := -1;
                    FOR b_i := 0 TO 100 DO 
                        IF outputMFCache[(9 * b_i) + mfID] > 0.0 THEN 
                            IF b_i < MFini[mfID] THEN 
                                MFini[mfID] := b_i;
                            END_IF;
                            MFfin[mfID] := b_i;
                        END_IF;
                    END_FOR;
                END_FOR;
                cacheMF_ok := TRUE;
            END_IF;
            (* Agregacion: solo las reglas activas (la regla r alimenta la salida r DIV 49) y, en cada
               una, solo los puntos donde su funcion de salida es mayor que 0. En los demas puntos el
               minimo vale 0 y no cambia el maximo, que parte de 0. *)
            FOR inputID := 0 TO 2 DO 
                aggIni[inputID] := 101;
                aggFin[inputID] := -1;
            END_FOR;
            FOR kAct := 0 TO nAct - 1 DO 
                ruleID := actRule[kAct];
                inputID := ruleID / 49;
                b_i := SINT_TO_DINT(d_d[(147 * inputID) + ruleID]);
                IF b_i <> 0 THEN 
                    area := c_rtb_antecedentOutp[ruleID];
                    IF area <> 0.0 THEN 
                        FOR sampleID := MFini[b_i - 1] TO MFfin[b_i - 1] DO 
                            mfVal := outputMFCache[(b_i - 1) + (9 * sampleID)];
                            IF mfVal > area THEN 
                                mfVal := area;
                            END_IF;
                            d_rtb_aggregatedOutp := (101 * inputID) + sampleID;
                            IF c_rtb_aggregatedOutp[d_rtb_aggregatedOutp] < mfVal THEN 
                                c_rtb_aggregatedOutp[d_rtb_aggregatedOutp] := mfVal;
                            END_IF;
                        END_FOR;
                        IF MFini[b_i - 1] < aggIni[inputID] THEN 
                            aggIni[inputID] := MFini[b_i - 1];
                        END_IF;
                        IF MFfin[b_i - 1] > aggFin[inputID] THEN 
                            aggFin[inputID] := MFfin[b_i - 1];
                        END_IF;
                    END_IF;
                END_IF;
            END_FOR;
            (* MATLAB Function: '<S2>/Defuzzify Outputs' incorporates:
             *  Constant: '<S2>/Output Sample Points'
             *  MATLAB Function: '<S2>/Evaluate Rule Antecedents' *)
            (* MATLAB Function 'Defuzzify Outputs': '<S5>:1' *)
            (* '<S5>:1:4' if SimulateUsing==1 && coder.internal.canUseExtrinsic ... *)
            (* '<S5>:1:5'         && (isa(aggregatedOutputs,'double') || isa(aggregatedOutputs,'single')) *)
            (* '<S5>:1:63' else *)
            (* '<S5>:1:64' if fis.inputFuzzySetType==1 *)
            (* '<S5>:1:65' if isequal(fis.type,uint8('mamdani')) *)
            (* '<S5>:1:66' defuzzifiedOutputs = ... *)
            (* '<S5>:1:67'                 fuzzy.internal.codegen.applyMamdaniDefuzzificationMethod(... *)
            (* '<S5>:1:68'                 samplePoints,sumAntecedentOutputs,aggregatedOutputs, ... *)
            (* '<S5>:1:69'                 fis,diagnostics); *)
            IF e = 0.0 THEN 
                c_rtb_defuzzifiedOut[0] := 0.0;
                c_rtb_defuzzifiedOut[1] := 0.0;
                c_rtb_defuzzifiedOut[2] := 0.0;
            ELSE 
                FOR inputID := 0 TO 2 DO 
                    mfVal := 0.0;
                    area := 0.0;
                    (* Area y momento en una sola pasada y solo donde la agregacion puede ser > 0;
                       fuera de ese rango vale 0 y sumar 0 no cambia ninguna de las dos sumas *)
                    FOR ruleID := aggIni[inputID] TO aggFin[inputID] DO 
                        area := c_rtb_aggregatedOutp[(101 * inputID) + ruleID] + area;
                        mfVal := (c_OutputSamplePoints[ruleID] * c_rtb_aggregatedOutp[(101 * inputID)
                             + ruleID]) + mfVal;
                    END_FOR;
                    IF area = 0.0 THEN 
                        c_rtb_defuzzifiedOut[inputID] := (c_OutputSamplePoints[100] + c_OutputSamplePoints[0])
                             / 2.0;
                    ELSE 
                        c_rtb_defuzzifiedOut[inputID] := (1.0 / area) * mfVal;
                    END_IF;
                END_FOR;
            END_IF;
            (* End of MATLAB Function: '<S2>/Defuzzify Outputs' *)
            (* End of Outputs for SubSystem: '<S1>/Fuzzy Logic  Controller' *)
            
            (* MATLAB Function: '<S1>/MATLAB Function7' *)
            (* Convierte las 3 salidas del FIS en aperturas de valvula. *)
            
            (* u_fis = [u_vpw; u_vpc; u_vpg]   (salida del FIS, rango [-1,1]) *)
            (* mv    = [vpw;   vpc;   vpg  ]   saturadas en [0.01, 0.99] *)
            
            (* Debe ejecutarse a Ts = 0.1 s (subsistema Fuzzy_ con Sample time = 0.1). *)
            
            (* MATLAB Function 'Fuzzy_/MATLAB Function7': '<S3>:1' *)
            (* ---------------- Ganancias de integracion ---------------- *)
            (* Valor original del script: Kcv = [1.5; 1.5; 1.5] *)
            (* '<S3>:1:13' Kcv = [4.0; 2.5; 2.25]; *)
            (* por muestra de 0.1 s *)
            (* ---------------- Limites de la apertura ---------------- *)
            (* '<S3>:1:16' MV_MIN = 0.01; *)
            (* '<S3>:1:17' MV_MAX = 0.99; *)
            (* '<S3>:1:19' cv0 = [MV_MIN; MV_MIN; MV_MIN]; *)
            (* arranque desde el minimo, como el script *)
            (* ---------------- Limitador de velocidad (opcional) ---------------- *)
            (* Desactivado por defecto para no alterar la respuesta validada. *)
            (* Poner en true si reaparece el chattering de vpg: recorta los saltos *)
            (* grandes (se midieron incrementos de hasta 0.154 en una sola ejecucion) *)
            (* sin afectar la dinamica lenta, cuyo percentil 99 es 0.0159. *)
            (* '<S3>:1:26' RATE_ENABLE = true; *)
            (* '<S3>:1:27' RATE_MAX    = [0.10; 0.10; 0.03]; *)
            (* por muestra de 0.1 s *)
            (* ---------------- Estados persistentes ---------------- *)
            (* '<S3>:1:32' if isempty(initialized) || reset ~= 0 *)
            IF  NOT d_initialized_not_em THEN 
                (* '<S3>:1:33' cv     = cv0; *)
                (* '<S3>:1:34' cv_ant = cv0; *)
                cv[0] := 0.01;
                cv_ant[0] := 0.01;
                cv[1] := 0.01;
                cv_ant[1] := 0.01;
                cv[2] := 0.01;
                cv_ant[2] := 0.01;
                (* '<S3>:1:35' initialized = true; *)
                d_initialized_not_em := TRUE;
            END_IF;
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            (* ---------------- Integracion del mando difuso ---------------- *)
            (* '<S3>:1:39' cv = cv + Kcv .* u_fis(:); *)
            (* Anti-windup: el acumulador se limita al mismo rango que la apertura *)
            (* '<S3>:1:42' for i = 1:3 *)
            (* ---------------- Limitador de velocidad ---------------- *)
            (* '<S3>:1:51' if RATE_ENABLE *)
            (* '<S3>:1:52' for i = 1:3 *)
            (* '<S3>:1:62' cv_ant = cv; *)
            (* ---------------- Salida ---------------- *)
            (* '<S3>:1:65' mv = cv; *)
            (* Outputs for Atomic SubSystem: '<Root>/Fuzzy_' *)
            (* MATLAB Function: '<S1>/MATLAB Function7' *)
            mfVal := (4.0 * c_rtb_defuzzifiedOut[0]) + cv[0];
            cv[0] := mfVal;
            (* '<S3>:1:43' if cv(i) > MV_MAX *)
            IF mfVal > 0.99 THEN 
                (* '<S3>:1:44' cv(i) = MV_MAX; *)
                mfVal := 0.99;
                cv[0] := 0.99;
            ELSIF mfVal < 0.01 THEN 
                (* '<S3>:1:45' elseif cv(i) < MV_MIN *)
                (* '<S3>:1:46' cv(i) = MV_MIN; *)
                mfVal := 0.01;
                cv[0] := 0.01;
            END_IF;
            (* '<S3>:1:53' d = cv(i) - cv_ant(i); *)
            b_d := mfVal - cv_ant[0];
            (* '<S3>:1:54' if d > RATE_MAX(i) *)
            IF b_d > 0.1 THEN 
                (* '<S3>:1:55' cv(i) = cv_ant(i) + RATE_MAX(i); *)
                mfVal := cv_ant[0] + 0.1;
                cv[0] := cv_ant[0] + 0.1;
            ELSIF b_d < -0.1 THEN 
                (* '<S3>:1:56' elseif d < -RATE_MAX(i) *)
                (* '<S3>:1:57' cv(i) = cv_ant(i) - RATE_MAX(i); *)
                mfVal := cv_ant[0] - 0.1;
                cv[0] := cv_ant[0] - 0.1;
            END_IF;
            cv_ant[0] := mfVal;
            (* Outport: '<Root>/mv' incorporates:
             *  MATLAB Function: '<S1>/MATLAB Function7' *)
            mv[0] := mfVal;
            (* MATLAB Function: '<S1>/MATLAB Function7' *)
            mfVal := (2.5 * c_rtb_defuzzifiedOut[1]) + cv[1];
            cv[1] := mfVal;
            (* '<S3>:1:43' if cv(i) > MV_MAX *)
            IF mfVal > 0.99 THEN 
                (* '<S3>:1:44' cv(i) = MV_MAX; *)
                mfVal := 0.99;
                cv[1] := 0.99;
            ELSIF mfVal < 0.01 THEN 
                (* '<S3>:1:45' elseif cv(i) < MV_MIN *)
                (* '<S3>:1:46' cv(i) = MV_MIN; *)
                mfVal := 0.01;
                cv[1] := 0.01;
            END_IF;
            (* '<S3>:1:53' d = cv(i) - cv_ant(i); *)
            b_d := mfVal - cv_ant[1];
            (* '<S3>:1:54' if d > RATE_MAX(i) *)
            IF b_d > 0.1 THEN 
                (* '<S3>:1:55' cv(i) = cv_ant(i) + RATE_MAX(i); *)
                mfVal := cv_ant[1] + 0.1;
                cv[1] := cv_ant[1] + 0.1;
            ELSIF b_d < -0.1 THEN 
                (* '<S3>:1:56' elseif d < -RATE_MAX(i) *)
                (* '<S3>:1:57' cv(i) = cv_ant(i) - RATE_MAX(i); *)
                mfVal := cv_ant[1] - 0.1;
                cv[1] := cv_ant[1] - 0.1;
            END_IF;
            cv_ant[1] := mfVal;
            (* Outport: '<Root>/mv' incorporates:
             *  MATLAB Function: '<S1>/MATLAB Function7' *)
            mv[1] := mfVal;
            (* MATLAB Function: '<S1>/MATLAB Function7' *)
            mfVal := (2.25 * c_rtb_defuzzifiedOut[2]) + cv[2];
            cv[2] := mfVal;
            (* '<S3>:1:43' if cv(i) > MV_MAX *)
            IF mfVal > 0.99 THEN 
                (* '<S3>:1:44' cv(i) = MV_MAX; *)
                mfVal := 0.99;
                cv[2] := 0.99;
            ELSIF mfVal < 0.01 THEN 
                (* '<S3>:1:45' elseif cv(i) < MV_MIN *)
                (* '<S3>:1:46' cv(i) = MV_MIN; *)
                mfVal := 0.01;
                cv[2] := 0.01;
            END_IF;
            (* '<S3>:1:53' d = cv(i) - cv_ant(i); *)
            b_d := mfVal - cv_ant[2];
            (* '<S3>:1:54' if d > RATE_MAX(i) *)
            IF b_d > 0.03 THEN 
                (* '<S3>:1:55' cv(i) = cv_ant(i) + RATE_MAX(i); *)
                mfVal := cv_ant[2] + 0.03;
                cv[2] := cv_ant[2] + 0.03;
            ELSIF b_d < -0.03 THEN 
                (* '<S3>:1:56' elseif d < -RATE_MAX(i) *)
                (* '<S3>:1:57' cv(i) = cv_ant(i) - RATE_MAX(i); *)
                mfVal := cv_ant[2] - 0.03;
                cv[2] := cv_ant[2] - 0.03;
            END_IF;
            cv_ant[2] := mfVal;
            (* Outport: '<Root>/mv' incorporates:
             *  MATLAB Function: '<S1>/MATLAB Function7' *)
            mv[2] := mfVal;
            (* End of Outputs for SubSystem: '<Root>/Fuzzy_' *)
            
            (* [DIAG] fin de la medicion: tiempo de esta ejecucion en ms *)
            "Diag_HIL".fuzzy_ms := RUNTIME("Diag_HIL".fuzzy_mem) * 1000.0;
            
            (* [DIAG] reinicio de estadisticas desde la tabla de observacion *)
            IF "Diag_HIL".fuzzy_reset THEN
                "Diag_HIL".fuzzy_n := 0;
                "Diag_HIL".fuzzy_sum_ms := 0.0;
                "Diag_HIL".fuzzy_max_ms := 0.0;
                "Diag_HIL".fuzzy_reset := FALSE;
            END_IF;
            
            (* [DIAG] promedio y maximo desde el ultimo reset *)
            (* [DIAG] Si el contador interno de RUNTIME da la vuelta, la medicion sale <= 0.0 y
               Siemens indica descartarla: solo se acumulan mediciones positivas. *)
            IF "Diag_HIL".fuzzy_ms > 0.0 THEN
                "Diag_HIL".fuzzy_n := "Diag_HIL".fuzzy_n + 1;
                "Diag_HIL".fuzzy_sum_ms := "Diag_HIL".fuzzy_sum_ms + "Diag_HIL".fuzzy_ms;
                "Diag_HIL".fuzzy_prom_ms := "Diag_HIL".fuzzy_sum_ms / DINT_TO_LREAL("Diag_HIL".fuzzy_n);
                "Diag_HIL".fuzzy_max_ms := MAX(IN1 := "Diag_HIL".fuzzy_max_ms, IN2 := "Diag_HIL".fuzzy_ms);
            END_IF;
        END_IF;
        (* Divisor 1:10 de PLC Coder DESACTIVADO (>= 0): la ley se calcula en cada     *)
        (* llamada. LLAMAR DESDE UN OB CICLICO DE 100 ms (en la 1212C la ley tarda      *)
        (* 45-68 ms y no cabe en un OB de 10 ms).                                      *)
        IF PLCGlobalVar_FUZZY.plc_ts_counter_fuzzy >= 0 THEN 
            PLCGlobalVar_FUZZY.plc_ts_counter_fuzzy := 0;
        ELSE 
            PLCGlobalVar_FUZZY.plc_ts_counter_fuzzy := PLCGlobalVar_FUZZY.plc_ts_counter_fuzzy + 1;
        END_IF;
END_CASE;
END_FUNCTION_BLOCK
