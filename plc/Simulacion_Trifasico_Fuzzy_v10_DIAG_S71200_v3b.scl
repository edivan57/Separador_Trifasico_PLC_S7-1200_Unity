    b_d: REAL;
    inputMFCache: ARRAY [0..41] OF REAL;
    inputID: DINT;
    mfVal: REAL;
    outputMFCache: ARRAY [0..908] OF REAL;   (* 9 funciones x 101 puntos *)
    sampleID: DINT;
    area: REAL;
    c_rtb_antecedentOutp: ARRAY [0..146] OF REAL;
    c_rtb_aggregatedOutp: ARRAY [0..302] OF REAL;
    c_rtb_defuzzifiedOut: ARRAY [0..2] OF REAL;
