
DATA_BLOCK PLCGlobalVarMPC
STRUCT 
    plc_ts_counter_MPC: DINT;
END_STRUCT
BEGIN
END_DATA_BLOCK
FUNCTION_BLOCK abs_g_MPC
VAR_OUTPUT
    y: ARRAY [0..71] OF REAL;
END_VAR
VAR_IN_OUT
    x: ARRAY [0..71] OF REAL;   (* solo lectura *)
END_VAR
VAR
    k: DINT;
END_VAR
FOR k := 0 TO 71 DO 
    y[k] := ABS(x[k]);
END_FOR;
END_FUNCTION_BLOCK
FUNCTION_BLOCK b_abs_MPC
VAR_OUTPUT
    y: ARRAY [0..18] OF REAL;
END_VAR
VAR_IN_OUT
    x: ARRAY [0..18] OF REAL;   (* solo lectura *)
END_VAR
VAR
    k: DINT;
END_VAR
FOR k := 0 TO 18 DO 
    y[k] := ABS(x[k]);
END_FOR;
END_FUNCTION_BLOCK
FUNCTION_BLOCK maximum2_MPC
VAR_INPUT
    y: REAL;
END_VAR
VAR_OUTPUT
    ex: ARRAY [0..71] OF REAL;
END_VAR
VAR_IN_OUT
    x: ARRAY [0..71] OF REAL;   (* solo lectura *)
END_VAR
VAR
    k: DINT;
END_VAR
FOR k := 0 TO 71 DO 
    ex[k] := MAX(IN1:=x[k], IN2:=y);
END_FOR;
END_FUNCTION_BLOCK
FUNCTION_BLOCK mpc_clipping_MPC
VAR_INPUT
    uk: ARRAY [0..2] OF REAL;
    uk1: ARRAY [0..2] OF REAL;
    b_uoff: ARRAY [0..2] OF REAL;
    b_ny: DINT;
    b_degrees: DINT;
END_VAR
VAR_OUTPUT
    uk_clipped: ARRAY [0..2] OF REAL;
END_VAR
VAR_IN_OUT
    b_Mlim: ARRAY [0..71] OF REAL;   (* solo lectura *)
    b_Mrows: ARRAY [0..71] OF DINT;  (* solo lectura *)
END_VAR
VAR
    nylim: DINT;
    umax: ARRAY [0..2] OF REAL;
    umin: ARRAY [0..2] OF REAL;
    dumin: ARRAY [0..2] OF REAL;
    dumax: ARRAY [0..2] OF REAL;
    iu: DINT;
    du: REAL;
    b_i: DINT;
    tmp: DINT;
    temp1: BOOL;
    temp2: BOOL;
    temp3: BOOL;
END_VAR
nylim := (400 * b_ny) + 1200;
uk_clipped[0] := uk[0];
umax[0] := 3.4028234663852886E+37;
umin[0] := -3.4028234663852886E+37;
dumin[0] := -3.4028234663852886E+37;
dumax[0] := 3.4028234663852886E+37;
uk_clipped[1] := uk[1];
umax[1] := 3.4028234663852886E+37;
umin[1] := -3.4028234663852886E+37;
dumin[1] := -3.4028234663852886E+37;
dumax[1] := 3.4028234663852886E+37;
uk_clipped[2] := uk[2];
umax[2] := 3.4028234663852886E+37;
umin[2] := -3.4028234663852886E+37;
dumin[2] := -3.4028234663852886E+37;
dumax[2] := 3.4028234663852886E+37;
FOR b_i := 0 TO 71 DO 
    iu := b_Mrows[b_i];
    temp1 := FALSE;
    temp2 := FALSE;
    temp3 := FALSE;
    IF iu > (nylim - 1200) THEN 
        IF iu <= (nylim - 1197) THEN 
            iu := (iu - nylim) + 1199;
            umax[iu] := b_Mlim[b_i] + b_uoff[iu];
        ELSE 
            temp3 := TRUE;
        END_IF;
    ELSE 
        temp3 := TRUE;
    END_IF;
    IF temp3 THEN 
        IF iu > (nylim - 600) THEN 
            IF iu <= (nylim - 597) THEN 
                iu := (iu - nylim) + 599;
                umin[iu] := ( -b_Mlim[b_i]) + b_uoff[iu];
            ELSE 
                temp2 := TRUE;
            END_IF;
        ELSE 
            temp2 := TRUE;
        END_IF;
    END_IF;
    IF temp2 THEN 
        IF iu > nylim THEN 
            IF iu <= (nylim + 3) THEN 
                dumax[(iu - nylim) - 1] := b_Mlim[b_i];
            ELSE 
                temp1 := TRUE;
            END_IF;
        ELSE 
            temp1 := TRUE;
        END_IF;
    END_IF;
    IF temp1 THEN 
        tmp := nylim + b_degrees;
        IF iu > (tmp - 1) THEN 
            IF iu <= (tmp + 2) THEN 
                dumin[(iu - nylim) - b_degrees] :=  -b_Mlim[b_i];
            END_IF;
        END_IF;
    END_IF;
END_FOR;
du := uk[0] - uk1[0];
IF du > dumax[0] THEN 
    uk_clipped[0] := uk1[0] + dumax[0];
ELSIF du < dumin[0] THEN 
    uk_clipped[0] := uk1[0] + dumin[0];
END_IF;
IF uk_clipped[0] > umax[0] THEN 
    uk_clipped[0] := umax[0];
ELSIF uk_clipped[0] < umin[0] THEN 
    uk_clipped[0] := umin[0];
END_IF;
du := uk[1] - uk1[1];
IF du > dumax[1] THEN 
    uk_clipped[1] := uk1[1] + dumax[1];
ELSIF du < dumin[1] THEN 
    uk_clipped[1] := uk1[1] + dumin[1];
END_IF;
IF uk_clipped[1] > umax[1] THEN 
    uk_clipped[1] := umax[1];
ELSIF uk_clipped[1] < umin[1] THEN 
    uk_clipped[1] := umin[1];
END_IF;
du := uk[2] - uk1[2];
IF du > dumax[2] THEN 
    uk_clipped[2] := uk1[2] + dumax[2];
ELSIF du < dumin[2] THEN 
    uk_clipped[2] := uk1[2] + dumin[2];
END_IF;
IF uk_clipped[2] > umax[2] THEN 
    uk_clipped[2] := umax[2];
ELSIF uk_clipped[2] < umin[2] THEN 
    uk_clipped[2] := umin[2];
END_IF;
END_FUNCTION_BLOCK
FUNCTION maximum_MPC: REAL
VAR_INPUT
    x: ARRAY [0..18] OF REAL;
END_VAR
VAR_TEMP
    k: DINT;
    x_0: REAL;
END_VAR
maximum_MPC := x[0];
FOR k := 0 TO 17 DO 
    x_0 := x[k + 1];
    IF maximum_MPC < x_0 THEN 
        maximum_MPC := x_0;
    END_IF;
END_FOR;
END_FUNCTION
FUNCTION_BLOCK DropConstraint_MPC
VAR_INPUT
    kDrop: DINT;
END_VAR
VAR_IN_OUT
    iA: ARRAY [0..71] OF BOOL;
    nA: DINT;
    iC: ARRAY [0..71] OF DINT;
END_VAR
VAR
    b_i: DINT;
END_VAR
IF kDrop > 0 THEN 
    iA[iC[kDrop - 1] - 1] := FALSE;
    IF kDrop < nA THEN 
        b_i := kDrop;
        WHILE b_i <= (nA - 1) DO
            iC[b_i - 1] := iC[b_i];
            b_i := b_i + 1;
        END_WHILE;
    END_IF;
    iC[nA - 1] := 0;
    nA := nA - 1;
END_IF;
END_FUNCTION_BLOCK
FUNCTION mtimes_MPC: REAL
VAR_INPUT
    b_A: ARRAY [0..18] OF REAL;
    B: ARRAY [0..18] OF REAL;
END_VAR
VAR_TEMP
    k: DINT;
END_VAR
mtimes_MPC := 0.0;
FOR k := 0 TO 18 DO 
    mtimes_MPC := (b_A[k] * B[k]) + mtimes_MPC;
END_FOR;
END_FUNCTION
FUNCTION xnrm2_MPC: REAL
VAR_INPUT
    b_n: DINT;
    x: ARRAY [0..360] OF REAL;
    ix0: DINT;
END_VAR
VAR_TEMP
    b_scale: REAL;
    kend: DINT;
    absxk: REAL;
    t: REAL;
    k: DINT;
END_VAR
xnrm2_MPC := 0.0;
IF b_n >= 1 THEN 
    IF b_n = 1 THEN 
        xnrm2_MPC := ABS(x[ix0 - 1]);
    ELSE 
        b_scale := 1.1754943508222875E-37;
        kend := (ix0 + b_n) - 1;
        k := ix0;
        WHILE k <= kend DO
            absxk := ABS(x[k - 1]);
            IF absxk > b_scale THEN 
                t := b_scale / absxk;
                xnrm2_MPC := ((xnrm2_MPC * t) * t) + 1.0;
                b_scale := absxk;
            ELSE 
                t := absxk / b_scale;
                xnrm2_MPC := (t * t) + xnrm2_MPC;
            END_IF;
            k := k + 1;
        END_WHILE;
        xnrm2_MPC := b_scale * SQRT(xnrm2_MPC);
    END_IF;
END_IF;
END_FUNCTION
FUNCTION_BLOCK xgerc_MPC
VAR_INPUT
    b_m: DINT;
    b_n: DINT;
    alpha1: REAL;
    ix0: DINT;
    y: ARRAY [0..18] OF REAL;
    ia0: DINT;
END_VAR
VAR_IN_OUT
    b_A: ARRAY [0..360] OF REAL;
END_VAR
VAR
    jA: DINT;
    jy: DINT;
    temp: REAL;
    ix: DINT;
    j: DINT;
    b_b: DINT;
    ijA: DINT;
END_VAR
IF alpha1 <> 0.0 THEN 
    jA := ia0 - 1;
    jy := 0;
    j := 0;
    WHILE j <= (b_n - 1) DO
        IF y[jy] <> 0.0 THEN 
            temp := y[jy] * alpha1;
            ix := ix0;
            ijA := jA;
            b_b := b_m + jA;
            WHILE (ijA + 1) <= b_b DO
                b_A[ijA] := (b_A[ix - 1] * temp) + b_A[ijA];
                ix := ix + 1;
                ijA := ijA + 1;
            END_WHILE;
        END_IF;
        jy := jy + 1;
        jA := jA + 19;
        j := j + 1;
    END_WHILE;
END_IF;
END_FUNCTION_BLOCK
FUNCTION_BLOCK xgemv_MPC
VAR_INPUT
    b_m: DINT;
    b_n: DINT;
    ia0: DINT;
    ix0: DINT;
END_VAR
VAR_IN_OUT
    y: ARRAY [0..18] OF REAL;
    b_A: ARRAY [0..360] OF REAL;   (* solo lectura, por referencia; hace tambien de x: en qr siempre x = b_A = c_A *)
END_VAR
VAR
    ix: DINT;
    b_c: REAL;
    b_iy: DINT;
    b_b: DINT;
    iac: DINT;
    b_d: DINT;
    ia: DINT;
END_VAR
IF (b_m <> 0) AND (b_n <> 0) THEN 
    b_iy := 0;
    WHILE b_iy <= (b_n - 1) DO
        y[b_iy] := 0.0;
        b_iy := b_iy + 1;
    END_WHILE;
    b_iy := 0;
    b_b := ((b_n - 1) * 19) + ia0;
    iac := ia0;
    WHILE iac <= b_b DO
        ix := ix0;
        b_c := 0.0;
        b_d := (iac + b_m) - 1;
        ia := iac;
        WHILE ia <= b_d DO
            b_c := (b_A[ia - 1] * b_A[ix - 1]) + b_c;
            ix := ix + 1;
            ia := ia + 1;
        END_WHILE;
        y[b_iy] := y[b_iy] + b_c;
        b_iy := b_iy + 1;
        iac := iac + 19;
    END_WHILE;
END_IF;
END_FUNCTION_BLOCK
FUNCTION_BLOCK qr_MPC
VAR_OUTPUT
    b_Q: ARRAY [0..360] OF REAL;
    b_R: ARRAY [0..360] OF REAL;
END_VAR
VAR_IN_OUT
    b_A: ARRAY [0..360] OF REAL;   (* se factoriza en el sitio: el llamador no vuelve a leer RLinv sin ponerla a cero *)
END_VAR
VAR
    i0_xgemv: xgemv_MPC;
    i0_xgerc: xgerc_MPC;
    tau: ARRAY [0..18] OF REAL;
    itau: DINT;
    work: ARRAY [0..18] OF REAL;
    ii: DINT;
    atmp: REAL;
    beta1: REAL;
    knt: DINT;
    c_lastc: DINT;
    coltop: DINT;
    b_coltop: DINT;
    c_A_0: REAL;
    a: REAL;
    exitg1: DINT;
    exitg2: DINT;
    temp7: REAL;
END_VAR
FOR ii := 0 TO 18 DO 
    tau[ii] := 0.0;
    work[ii] := 0.0;
END_FOR;
FOR itau := 0 TO 18 DO 
    ii := (itau * 19) + itau;
    IF (itau + 1) < 19 THEN 
        atmp := b_A[ii];
        tau[itau] := 0.0;
        beta1 := xnrm2_MPC(b_n := 18 - itau, x := b_A, ix0 := ii + 2);
        IF beta1 <> 0.0 THEN 
            c_A_0 := b_A[ii];
            a := ABS(c_A_0);
            beta1 := ABS(beta1);
            IF a < beta1 THEN 
                a := a / beta1;
                beta1 := SQRT((a * a) + 1.0) * beta1;
            ELSIF a > beta1 THEN 
                beta1 := beta1 / a;
                beta1 := SQRT((beta1 * beta1) + 1.0) * a;
            ELSE 
                beta1 := a * 1.4142135623730951;
            END_IF;
            IF c_A_0 >= 0.0 THEN 
                beta1 :=  -beta1;
            END_IF;
            IF ABS(beta1) < 1.1754943508222875E-37 THEN 
                knt := 0;
                REPEAT 
                    exitg1 := 0;
                    knt := knt + 1;
                    c_lastc := (ii - itau) + 19;
                    b_coltop := ii + 1;
                    WHILE (b_coltop + 1) <= c_lastc DO
                        b_A[b_coltop] := 3.4028234663852886E+37 * b_A[b_coltop];
                        b_coltop := b_coltop + 1;
                    END_WHILE;
                    beta1 := beta1 * 3.4028234663852886E+37;
                    atmp := atmp * 3.4028234663852886E+37;
                    IF ABS(beta1) < 1.1754943508222875E-37 THEN 
                        IF knt < 20 THEN 
                            ;
                            ;
                        ELSE 
                            exitg1 := 1;
                        END_IF;
                    ELSE 
                        exitg1 := 1;
                    END_IF;
                UNTIL NOT(exitg1 = 0)
                END_REPEAT;
                a := ABS(atmp);
                temp7 := xnrm2_MPC(b_n := 18 - itau, x := b_A, ix0 := ii + 2);
                beta1 := ABS(temp7);
                IF a < beta1 THEN 
                    a := a / beta1;
                    beta1 := SQRT((a * a) + 1.0) * beta1;
                ELSIF a > beta1 THEN 
                    beta1 := beta1 / a;
                    beta1 := SQRT((beta1 * beta1) + 1.0) * a;
                ELSE 
                    beta1 := a * 1.4142135623730951;
                END_IF;
                IF atmp >= 0.0 THEN 
                    beta1 :=  -beta1;
                END_IF;
                tau[itau] := (beta1 - atmp) / beta1;
                atmp := 1.0 / (atmp - beta1);
                b_coltop := ii + 1;
                WHILE (b_coltop + 1) <= c_lastc DO
                    b_A[b_coltop] := atmp * b_A[b_coltop];
                    b_coltop := b_coltop + 1;
                END_WHILE;
                c_lastc := 0;
                WHILE c_lastc <= (knt - 1) DO
                    beta1 := beta1 * 1.1754943508222875E-37;
                    c_lastc := c_lastc + 1;
                END_WHILE;
                atmp := beta1;
            ELSE 
                tau[itau] := (beta1 - c_A_0) / beta1;
                atmp := 1.0 / (c_A_0 - beta1);
                knt := (ii - itau) + 19;
                c_lastc := ii + 1;
                WHILE (c_lastc + 1) <= knt DO
                    b_A[c_lastc] := atmp * b_A[c_lastc];
                    c_lastc := c_lastc + 1;
                END_WHILE;
                atmp := beta1;
            END_IF;
        END_IF;
        b_A[ii] := 1.0;
        IF tau[itau] <> 0.0 THEN 
            knt := 19 - itau;
            c_lastc := (ii - itau) + 18;
            REPEAT 
                exitg1 := 0;
                IF knt > 0 THEN 
                    IF b_A[c_lastc] = 0.0 THEN 
                        knt := knt - 1;
                        c_lastc := c_lastc - 1;
                    ELSE 
                        exitg1 := 1;
                    END_IF;
                ELSE 
                    exitg1 := 1;
                END_IF;
            UNTIL NOT(exitg1 = 0)
            END_REPEAT;
            c_lastc := 18 - itau;
            REPEAT 
                exitg2 := 0;
                IF c_lastc > 0 THEN 
                    b_coltop := (((c_lastc - 1) * 19) + ii) + 19;
                    coltop := b_coltop;
                    REPEAT 
                        exitg1 := 0;
                        IF (coltop + 1) <= (b_coltop + knt) THEN 
                            IF b_A[coltop] <> 0.0 THEN 
                                exitg1 := 1;
                            ELSE 
                                coltop := coltop + 1;
                            END_IF;
                        ELSE 
                            c_lastc := c_lastc - 1;
                            exitg1 := 2;
                        END_IF;
                    UNTIL NOT(exitg1 = 0)
                    END_REPEAT;
                    IF exitg1 = 1 THEN 
                        exitg2 := 1;
                    END_IF;
                ELSE 
                    exitg2 := 1;
                END_IF;
            UNTIL NOT(exitg2 = 0)
            END_REPEAT;
        ELSE 
            knt := 0;
            c_lastc := 0;
        END_IF;
        IF knt > 0 THEN 
            i0_xgemv(b_m := knt, b_n := c_lastc, b_A := b_A, ia0 := ii + 20, ix0 := ii + 1, y := work);
            i0_xgerc(b_m := knt, b_n := c_lastc, alpha1 :=  -tau[itau], ix0 := ii + 1, y := work, b_A := b_A, ia0 := ii + 20)
                ;
        END_IF;
        b_A[ii] := atmp;
    ELSE 
        tau[18] := 0.0;
    END_IF;
END_FOR;
FOR itau := 0 TO 18 DO 
    ii := 0;
    WHILE ii <= itau DO
        b_R[ii + (19 * itau)] := b_A[(19 * itau) + ii];
        ii := ii + 1;
    END_WHILE;
    ii := itau + 1;
    WHILE (ii + 1) < 20 DO
        b_R[ii + (19 * itau)] := 0.0;
        ii := ii + 1;
    END_WHILE;
    work[itau] := 0.0;
END_FOR;
FOR ii := 18 TO 0 BY -1 DO 
    knt := ((ii * 19) + ii) + 20;
    IF (ii + 1) < 19 THEN 
        b_A[knt - 20] := 1.0;
        IF tau[ii] <> 0.0 THEN 
            c_lastc := 19 - ii;
            b_coltop := knt - ii;
            REPEAT 
                exitg1 := 0;
                IF c_lastc > 0 THEN 
                    IF b_A[b_coltop - 2] = 0.0 THEN 
                        c_lastc := c_lastc - 1;
                        b_coltop := b_coltop - 1;
                    ELSE 
                        exitg1 := 1;
                    END_IF;
                ELSE 
                    exitg1 := 1;
                END_IF;
            UNTIL NOT(exitg1 = 0)
            END_REPEAT;
            b_coltop := 18 - ii;
            REPEAT 
                exitg2 := 0;
                IF b_coltop > 0 THEN 
                    coltop := ((b_coltop - 1) * 19) + knt;
                    itau := coltop;
                    REPEAT 
                        exitg1 := 0;
                        IF itau <= ((coltop + c_lastc) - 1) THEN 
                            IF b_A[itau - 1] <> 0.0 THEN 
                                exitg1 := 1;
                            ELSE 
                                itau := itau + 1;
                            END_IF;
                        ELSE 
                            b_coltop := b_coltop - 1;
                            exitg1 := 2;
                        END_IF;
                    UNTIL NOT(exitg1 = 0)
                    END_REPEAT;
                    IF exitg1 = 1 THEN 
                        exitg2 := 1;
                    END_IF;
                ELSE 
                    exitg2 := 1;
                END_IF;
            UNTIL NOT(exitg2 = 0)
            END_REPEAT;
        ELSE 
            c_lastc := 0;
            b_coltop := 0;
        END_IF;
        IF c_lastc > 0 THEN 
            i0_xgemv(b_m := c_lastc, b_n := b_coltop, b_A := b_A, ia0 := knt, ix0 := knt - 19, y := work);
            i0_xgerc(b_m := c_lastc, b_n := b_coltop, alpha1 :=  -tau[ii], ix0 := knt - 19, y := work, b_A := b_A, ia0 := knt)
                ;
        END_IF;
        c_lastc := (knt - ii) - 1;
        b_coltop := knt - 19;
        WHILE (b_coltop + 1) <= c_lastc DO
            b_A[b_coltop] := ( -tau[ii]) * b_A[b_coltop];
            b_coltop := b_coltop + 1;
        END_WHILE;
    END_IF;
    b_A[knt - 20] := 1.0 - tau[ii];
    c_lastc := 0;
    WHILE c_lastc <= (ii - 1) DO
        b_A[(knt - c_lastc) - 21] := 0.0;
        c_lastc := c_lastc + 1;
    END_WHILE;
END_FOR;
FOR ii := 0 TO 360 DO 
    b_Q[ii] := b_A[ii];
END_FOR;
END_FUNCTION_BLOCK
FUNCTION b_norm_MPC: REAL
VAR_INPUT
    x: ARRAY [0..18] OF REAL;
END_VAR
VAR_TEMP
    b_scale: REAL;
    absxk: REAL;
    t: REAL;
    k: DINT;
END_VAR
b_norm_MPC := 0.0;
b_scale := 1.1754943508222875E-37;
FOR k := 0 TO 18 DO 
    absxk := ABS(x[k]);
    IF absxk > b_scale THEN 
        t := b_scale / absxk;
        b_norm_MPC := ((b_norm_MPC * t) * t) + 1.0;
        b_scale := absxk;
    ELSE 
        t := absxk / b_scale;
        b_norm_MPC := (t * t) + b_norm_MPC;
    END_IF;
END_FOR;
b_norm_MPC := b_scale * SQRT(b_norm_MPC);
END_FUNCTION
FUNCTION_BLOCK mpcblock_refmd_MPC
VAR_INPUT
    b_ref: ARRAY [0..2] OF REAL;
    b_yoff: ARRAY [0..2] OF REAL;
    b_RYscale: ARRAY [0..2] OF REAL;
END_VAR
VAR_OUTPUT
    rseq: ARRAY [0..2] OF REAL;   (* antes 0..599: solo se usan rseq[0..2] *)
    v: REAL;
END_VAR
VAR
    b_i: DINT;
    ref_0: REAL;
    ref_1: REAL;
    ref_2: REAL;
    b_RYscale_0: REAL;
    b_RYscale_1: REAL;
    b_RYscale_2: REAL;
    b_yoff_0: REAL;
    b_yoff_1: REAL;
    b_yoff_2: REAL;
END_VAR
ref_0 := b_ref[0];
ref_1 := b_ref[1];
ref_2 := b_ref[2];
b_RYscale_0 := b_RYscale[0];
b_RYscale_1 := b_RYscale[1];
b_RYscale_2 := b_RYscale[2];
b_yoff_0 := b_yoff[0];
b_yoff_1 := b_yoff[1];
b_yoff_2 := b_yoff[2];
FOR b_i := 0 TO 0 DO    (* solo rseq[0..2] se usa *)
    rseq[b_i * 3] := (ref_0 * b_RYscale_0) - b_yoff_0;
    rseq[(b_i * 3) + 1] := (ref_1 * b_RYscale_1) - b_yoff_1;
    rseq[(b_i * 3) + 2] := (ref_2 * b_RYscale_2) - b_yoff_2;
END_FOR;
v := 1.0;
END_FUNCTION_BLOCK
FUNCTION rt_floord_MPC: REAL
VAR_INPUT
    u: REAL;
END_VAR
rt_floord_MPC := DINT_TO_REAL(TRUNC(u));
IF u = rt_floord_MPC THEN 
    rt_floord_MPC := u;
ELSIF u < 0.0 THEN 
    rt_floord_MPC := rt_floord_MPC - 1.0;
END_IF;
