            (* return_cost, return_mvseq, return_xseq, return_ovseq, isLTV *)
            (* no_ywt, no_uwt, no_duwt, no_rhoeps, no_md, no_ref, no_uref, no_mv *)
            (* CustomEstimation, no_cc, isHyb, isDouble *)
            (* ASOptions *)
            (* IPOptions  *)
            (* ADOptions *)
            (* MIQPOptions *)
            (* Parameters *)
            (* '<S24>:1:95' isSimulation = coder.target('Sfun') && ~coder.target('RtwForRapid') && ~coder.target('RtwForSim'); *)
            (* '<S24>:1:96' isAdaptive = false; *)
            (* '<S24>:1:97' isLTV = false; *)
            (* '<S24>:1:98' ZERO = zeros('like',ref); *)
            (* '<S24>:1:99' ONE = ones('like',ref); *)
            (* '<S24>:1:100' hasMD = nv>int32(1); *)
            (* Pre-allocate all the MEX block outputs for the simulation mode *)
            (* '<S24>:1:105' if isSimulation *)
            (* Get reference and MD signals -- accounting for previewing *)
            (* '<S24>:1:119' if isSimulation *)
            (* '<S24>:1:126' else *)
            (* When doing code generation, use M code directly *)
            (* '<S24>:1:128' [rseq, vseq, v] = mpcblock_refmd(ref,md,nv,ny,p,yoff,voff,no_md,no_ref,openloopflag, RYscale, RMDscale); *)
            i0_mpcblock_refmd(b_ref := b_ref, b_yoff := MPC_3_b_myoff, b_RYscale := MPC_3_b_RYscale);
            rseq := i0_mpcblock_refmd.rseq;
                        v := i0_mpcblock_refmd.v;
            (* External MV override.   *)
            (* NOTE: old_u and ext_mv input signals are dimensionless but include offset *)
            (* '<S24>:1:133' old_u = old_u - uoff; *)
            rMin := last_mv_DSTATE[0] - 0.656128124791873;
            Xnorm0 := last_mv_DSTATE[1] - 0.237985602615591;
            cMin := last_mv_DSTATE[2] - 0.474364026109265;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* '<S24>:1:134' if no_mv *)
            (* '<S24>:1:135' delmv = zeros(nu,1,'like',ref); *)
            (* Obtain x[k|k] *)
            (* '<S24>:1:143' xk = xk - xoff; *)
            (* Remove offset *)
            (* '<S24>:1:144' if CustomEstimation *)
            (* '<S24>:1:147' else *)
            (* Default state estimation.     *)
            (* Scale measured output and remove offset. *)
            (* '<S24>:1:150' ym = ym.*RYscale(myindex) - myoff; *)
            (* Correct x(k|k-1) for possible external mv override. *)
            (* NOTE:  Offset was removed from x[k|k-1] at k=0. *)
            (* '<S24>:1:153' xk = xk + Bu*delmv; *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* MATLAB Function: '<S23>/optimizer' incorporates:
             *  Memory: '<S3>/last_x' *)
            FOR kDrop := 0 TO 6 DO 
                xk[kDrop] := last_x_PreviousInput[kDrop] - MPC_3_b_xoff[kDrop];
            END_FOR;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* Measurement upate to x(k|k) *)
            (* '<S24>:1:155' ym_est = C(myindex,:)*xk + Dv(myindex,:)*v; *)
            (* '<S24>:1:156' y_innov = ym - ym_est; *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* MATLAB Function: '<S23>/optimizer' *)
            FOR j_k := 0 TO 2 DO 
                cVal := 0.0;
                FOR D_tmp := 0 TO 6 DO 
                    cVal := (b_a[(3 * D_tmp) + j_k] * xk[D_tmp]) + cVal;
                END_FOR;
                y_innov[j_k] := ((moorx[j_k] * MPC_3_b_RYscale[j_k]) - MPC_3_b_myoff[j_k]) - cVal;
            END_FOR;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* '<S24>:1:157' xest = xk + M*y_innov; *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* MATLAB Function: '<S23>/optimizer' *)
            cVal := y_innov[1];
            t := y_innov[0];
            y_innov_0 := y_innov[2];
            FOR j_k := 0 TO 6 DO 
                rtb_xest[j_k] := (((MPC_3_c_a[j_k + 7] * cVal) + (MPC_3_c_a[j_k] * t)) + (MPC_3_c_a[j_k + 14] * y_innov_0)
                    ) + xk[j_k];
            END_FOR;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* Real-time MV target override *)
            (* Note: utargetValue is a vector length p*nu.   *)
            (* '<S24>:1:162' if no_uref *)
            (* no external utarget *)
            (* '<S24>:1:164' utargetValue = utarget; *)
            (* Real-time custom constraint override (scaled E/F/S) *)
            (* '<S24>:1:173' if ~no_cc *)
            (* '<S24>:1:182' return_sequence = return_mvseq || return_xseq || return_ovseq; *)
            (* '<S24>:1:183' if isSimulation *)
            (* '<S24>:1:214' else *)
            (* When doing code generation, use M code directly *)
            (* '<S24>:1:216' [u, cost, useq, status, iAout] = mpcblock_optimizer(... *)
            (* '<S24>:1:217'             rseq, vseq, umin, umax, ymin, ymax, switch_in, xest, old_u, iA, ... *)
            (* '<S24>:1:218'             isQP, nu, ny, degrees, Hinv, Kx, Ku1, Kut, Kr, Kv, Mlim, ... *)
            (* '<S24>:1:219'             Mx, Mu1, Mv, utargetValue, p, uoff, voff, yoff, ... *)
            (* '<S24>:1:220'             false, CustomSolverCodeGen, UseSuboptimalSolution, ... *)
            (* '<S24>:1:221'             UseActiveSetSolver, ASOptions, IPOptions, ADOptions, MIQPOptions, nxQP, openloopflag, ... *)
            (* '<S24>:1:222'             no_umin, no_umax, no_ymin, no_ymax, no_cc, switch_inport, ... *)
            (* '<S24>:1:223'             no_switch, enable_value, return_cost, H, return_sequence, Linv, Ac, ... *)
            (* '<S24>:1:224'             ywt, uwt, duwt, ewt, no_ywt, no_uwt, no_duwt, no_rhoeps,... *)
            (* '<S24>:1:225'             Wy, Wdu, Jm, SuJm, Su1, Sx, Hv, Wu, I1, ... *)
            (* '<S24>:1:226'             isAdaptive, isLTV, A, Bu, Bv, C, Dv, ... *)
            (* '<S24>:1:227'             Mrows, nCC, Ecc, Fcc, Scc, Gcc, RYscale, RMVscale, m, ... *)
            (* '<S24>:1:228'             isHyb, Mdis, Ndis, Vdis, numdis, maxdis); *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* MATLAB Function: '<S23>/optimizer' *)
            FOR j_k := 0 TO 71 DO 
                b_b[j_k] :=  -((((DINT_TO_REAL(SINT_TO_DINT(d_a[j_k + 72])) * Xnorm0) + (DINT_TO_REAL(SINT_TO_DINT(d_a[j_k])) * rMin)
                    ) + (DINT_TO_REAL(SINT_TO_DINT(d_a[j_k + 144])) * cMin)) + MPC_3_b_Mlim[j_k]);
            END_FOR;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* MATLAB Function: '<S23>/optimizer' *)
            FOR kDrop := 0 TO 18 DO 
                z[kDrop] := 0.0;
            END_FOR;
            FOR b_i := 0 TO 17 DO 
                cVal := 0.0;
                FOR j_k := 0 TO 6 DO 
                    cVal := (MPC_3_b_Kx[(7 * b_i) + j_k] * rtb_xest[j_k]) + cVal;
                END_FOR;
                (* Kr*rseq con Kr reducida: 54 operaciones en lugar de 10800 *)
                t := ((MPC_3_b_Kr[3 * b_i] * rseq[0]) + (MPC_3_b_Kr[(3 * b_i) + 1] * rseq[1])) + (MPC_3_b_Kr[(3 * b_i) + 2] * rseq[2]);
                z[b_i] := (((MPC_3_b_Ku1[(3 * b_i) + 1] * Xnorm0) + (MPC_3_b_Ku1[3 * b_i] * rMin)) + (MPC_3_b_Ku1[(3 * b_i)
                     + 2] * cMin)) + (cVal + t);
            END_FOR;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* MATLAB Function: '<S23>/optimizer' *)
            FOR kDrop := 0 TO 18 DO 
                zopt[kDrop] := 0.0;
            END_FOR;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* MATLAB Function: '<S23>/optimizer' *)
            FOR kDrop := 0 TO 71 DO 
                aZZ1[kDrop] := 0.0;
            END_FOR;
            b_i := 1;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* MATLAB Function: '<S23>/optimizer' *)
            FOR kDrop := 0 TO 18 DO 
                b_r[kDrop] := 0.0;
            END_FOR;
            rMin := 0.0;
            cTolComputed := FALSE;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* MATLAB Function: '<S23>/optimizer' incorporates:
             *  Memory: '<S3>/Memory'
             *  UnitDelay: '<S3>/last_mv' *)
            FOR kDrop := 0 TO 71 DO 
                cTol[kDrop] := 1.0;
                iC[kDrop] := 0;
            END_FOR;
            nA := 0;
            FOR tmp := 0 TO 71 DO 
                IF Memory_PreviousInput[tmp] THEN 
                    nA := nA + 1;
                    iC[nA - 1] := tmp + 1;
                END_IF;
            END_FOR;
            temp1 := FALSE;
            IF nA > 0 THEN 
                FOR kDrop := 0 TO 37 DO 
                    Opt[kDrop] := 0.0;
                END_FOR;
                FOR kDrop := 0 TO 18 DO 
                    Rhs[kDrop] := z[kDrop];
                    Rhs[kDrop + 19] := 0.0;
                END_FOR;
                DualFeasible := FALSE;
                Xnorm0 := 0.3 * DINT_TO_REAL(nA);
                IF Xnorm0 >= 0.5 THEN 
                    tmp := TRUNC(rt_floord_MPC(u := Xnorm0 + 0.5));
                ELSE 
                    tmp := 0;
                END_IF;
                IF tmp <= 5 THEN 
                    tmp := 5;
                END_IF;
                ColdReset := FALSE;
                REPEAT 
                    exitg3 := 0;
                    IF (( NOT DualFeasible) AND (nA > 0)) AND (b_i <= 10) THEN 
                        kDrop := 1;
                        FOR j_k := 0 TO 360 DO 
                            RLinv[j_k] := 0.0;
                        END_FOR;
                        iSave := 0;
                        WHILE iSave <= (nA - 1) DO
                            iC_0 := iC[iSave];
                            FOR j_k := 0 TO 18 DO 
                                b_H_tmp := j_k + (19 * iSave);
                                RLinv[b_H_tmp] := 0.0;
                                FOR D_tmp := 0 TO 17 DO 
                                    RLinv[b_H_tmp] := (SINT_TO_REAL(AcS[((72 * D_tmp) + iC_0) - 1]) * MPC_3_b_Linv[(19 * D_tmp) + j_k])
                                         + RLinv[b_H_tmp];
                                END_FOR;
                                RLinv[b_H_tmp] := (AcSlack[iC_0 - 1] * MPC_3_b_Linv[342 + j_k]) + RLinv[b_H_tmp];   (* columna 18 *)
                            END_FOR;
                            iSave := iSave + 1;
                        END_WHILE;
                        i0_qr(b_A := RLinv);
                                                                        iSave := 0;
                        REPEAT 
                            exitg4 := 0;
                            IF iSave <= (nA - 1) THEN 
                                IF ABS(i0_qr.b_R[(19 * iSave) + iSave]) < 1.0E-12 THEN 
                                    kDrop := -2;
                                    exitg4 := 1;
                                ELSE 
                                    iSave := iSave + 1;
                                END_IF;
                            ELSE 
                                FOR iSave := 0 TO 18 DO 
                                    FOR w_i := 0 TO 18 DO 
                                        cMin := 0.0;
                                        FOR j_k := 0 TO 18 DO 
                                            cMin := (MPC_3_b_Linv[(19 * iSave) + j_k] * i0_qr.b_Q[(19 * w_i) + j_k]) + cMin;
                                        END_FOR;
                                        TL[iSave + (19 * w_i)] := cMin;
                                    END_FOR;
                                END_FOR;
                                FOR j_k := 0 TO 360 DO 
                                    RLinv[j_k] := 0.0;
                                END_FOR;
                                iSave := nA - 1;
                                WHILE (iSave + 1) > 0 DO
                                    b_H_tmp := iSave + (19 * iSave);
                                    RLinv[b_H_tmp] := 1.0;
                                    w_i := iSave;
                                    WHILE (w_i + 1) <= nA DO
                                        j_k := (19 * w_i) + iSave;
                                        RLinv[j_k] := RLinv[j_k] / i0_qr.b_R[b_H_tmp];
                                        w_i := w_i + 1;
                                    END_WHILE;
                                    IF (iSave + 1) > 1 THEN 
                                        w_i := 0;
                                        WHILE w_i <= (iSave - 1) DO
                                            j_k := iSave;
                                            WHILE (j_k + 1) <= nA DO
                                                b_H_tmp := (19 * j_k) + w_i;
                                                RLinv[b_H_tmp] := RLinv[b_H_tmp] - (i0_qr.b_R[(19 * iSave) + w_i] * RLinv[(19 * j_k)
                                                     + iSave]);
                                                j_k := j_k + 1;
                                            END_WHILE;
                                            w_i := w_i + 1;
                                        END_WHILE;
                                    END_IF;
                                    iSave := iSave - 1;
                                END_WHILE;
                                FOR iSave := 0 TO 18 DO 
                                    w_i := iSave;
                                    WHILE (w_i + 1) <= 19 DO
                                        b_H[iSave + (19 * w_i)] := 0.0;
                                        j_k := nA;
                                        WHILE (j_k + 1) <= 19 DO
                                            b_H_tmp := (19 * w_i) + iSave;
                                            b_H[b_H_tmp] := b_H[b_H_tmp] - (TL[(19 * j_k) + iSave] * TL[(19 * j_k) + w_i])
                                                ;
                                            j_k := j_k + 1;
                                        END_WHILE;
                                        b_H[w_i + (19 * iSave)] := b_H[(19 * w_i) + iSave];
                                        w_i := w_i + 1;
                                    END_WHILE;
                                END_FOR;
                                iSave := 0;
                                WHILE iSave <= (nA - 1) DO
                                    FOR w_i := 0 TO 18 DO 
                                        D_tmp := w_i + (19 * iSave);
                                        b_D[D_tmp] := 0.0;
                                        j_k := iSave;
                                        WHILE (j_k + 1) <= nA DO
                                            b_D[D_tmp] := (TL[(19 * j_k) + w_i] * RLinv[(19 * j_k) + iSave]) + b_D[D_tmp];
                                            j_k := j_k + 1;
                                        END_WHILE;
                                    END_FOR;
                                    iSave := iSave + 1;
                                END_WHILE;
                                exitg4 := 1;
                            END_IF;
                        UNTIL NOT(exitg4 = 0)
                        END_REPEAT;
                        IF kDrop < 0 THEN 
                            IF ColdReset THEN 
                                b_i := -2;
                                exitg3 := 2;
                            ELSE 
                                nA := 0;
                                FOR kDrop := 0 TO 71 DO 
                                    rtb_iAout[kDrop] := FALSE;
                                    iC[kDrop] := 0;
                                END_FOR;
                                ColdReset := TRUE;
                            END_IF;
                        ELSE 
                            kDrop := 0;
                            WHILE kDrop <= (nA - 1) DO
                                Rhs[kDrop + 19] := b_b[iC[kDrop] - 1];
                                iSave := kDrop;
                                WHILE (iSave + 1) <= nA DO
                                    b_H_tmp := iSave + (19 * kDrop);
                                    TL[b_H_tmp] := 0.0;
                                    w_i := 0;
                                    WHILE w_i <= (nA - 1) DO
                                        TL[b_H_tmp] := (RLinv[(19 * w_i) + iSave] * RLinv[(19 * w_i) + kDrop]) + TL[b_H_tmp];
                                        w_i := w_i + 1;
                                    END_WHILE;
                                    TL[kDrop + (19 * iSave)] := TL[b_H_tmp];
                                    iSave := iSave + 1;
                                END_WHILE;
                                kDrop := kDrop + 1;
                            END_WHILE;
                            FOR kDrop := 0 TO 18 DO 
                                Xnorm0 := 0.0;
                                FOR j_k := 0 TO 18 DO 
                                    Xnorm0 := (b_H[(19 * j_k) + kDrop] * Rhs[j_k]) + Xnorm0;
                                END_FOR;
                                Opt[kDrop] := Xnorm0;
                                iSave := 0;
                                WHILE iSave <= (nA - 1) DO
                                    Opt[kDrop] := (b_D[(19 * iSave) + kDrop] * Rhs[iSave + 19]) + Opt[kDrop];
                                    iSave := iSave + 1;
                                END_WHILE;
                            END_FOR;
                            kDrop := 0;
                            WHILE kDrop <= (nA - 1) DO
                                Xnorm0 := 0.0;
                                FOR j_k := 0 TO 18 DO 
                                    Xnorm0 := (b_D[(19 * kDrop) + j_k] * Rhs[j_k]) + Xnorm0;
                                END_FOR;
                                Opt[kDrop + 19] := Xnorm0;
                                iSave := 0;
                                WHILE iSave <= (nA - 1) DO
                                    Opt[kDrop + 19] := (TL[(19 * iSave) + kDrop] * Rhs[iSave + 19]) + Opt[kDrop + 19];
                                    iSave := iSave + 1;
                                END_WHILE;
                                kDrop := kDrop + 1;
                            END_WHILE;
                            Xnorm0 := -1.0E-12;
                            kDrop := 0;
                            iSave := 19;
                            WHILE (iSave - 19) <= (nA - 1) DO
                                aZZ1[iC[iSave - 19] - 1] := Opt[iSave];
                                IF Opt[iSave] < Xnorm0 THEN 
                                    IF (iSave - 18) <= nA THEN 
                                        kDrop := iSave - 18;
                                        Xnorm0 := Opt[iSave];
                                    END_IF;
                                END_IF;
                                iSave := iSave + 1;
                            END_WHILE;
                            IF kDrop <= 0 THEN 
                                DualFeasible := TRUE;
                                FOR kDrop := 0 TO 18 DO 
                                    zopt[kDrop] := Opt[kDrop];
                                END_FOR;
                            ELSE 
                                b_i := b_i + 1;
                                IF b_i > tmp THEN 
                                    nA := 0;
                                    FOR kDrop := 0 TO 71 DO 
                                        rtb_iAout[kDrop] := FALSE;
                                        iC[kDrop] := 0;
                                    END_FOR;
                                    ColdReset := TRUE;
                                ELSE 
                                    aZZ1[iC[kDrop - 1] - 1] := 0.0;
                                    i0_DropConstraint(kDrop := kDrop, iA := rtb_iAout, nA := nA, iC := iC);
                                END_IF;
                            END_IF;
                        END_IF;
                    ELSE 
                        IF nA <= 0 THEN 
                            FOR kDrop := 0 TO 71 DO 
                                aZZ1[kDrop] := 0.0;
                            END_FOR;
                            FOR tmp := 0 TO 18 DO 
                                Xnorm0 := 0.0;
                                FOR j_k := 0 TO 18 DO 
                                    Xnorm0 := (( -MPC_3_b_Hinv[(19 * j_k) + tmp]) * z[j_k]) + Xnorm0;
                                END_FOR;
                                zopt[tmp] := Xnorm0;
                            END_FOR;
                        END_IF;
                        exitg3 := 1;
                    END_IF;
                UNTIL NOT(exitg3 = 0)
                END_REPEAT;
                IF exitg3 = 1 THEN 
                    temp1 := TRUE;
                END_IF;
            ELSE 
                FOR tmp := 0 TO 18 DO 
                    Xnorm0 := 0.0;
                    FOR j_k := 0 TO 18 DO 
                        Xnorm0 := (( -MPC_3_b_Hinv[(19 * j_k) + tmp]) * z[j_k]) + Xnorm0;
                    END_FOR;
                    zopt[tmp] := Xnorm0;
                END_FOR;
                temp1 := TRUE;
            END_IF;
            IF temp1 THEN 
                Xnorm0 := b_norm_MPC(x := zopt);
                REPEAT 
                    exitg2 := 0;
                    IF b_i <= 10 THEN 
                        cMin := -1.0E-6;
                        tmp := -1;
                        FOR kDrop := 0 TO 71 DO 
                            IF  NOT cTolComputed THEN 
                                FOR j_k := 0 TO 17 DO 
                                    b_Ac[j_k] := SINT_TO_REAL(AcS[(72 * j_k) + kDrop]) * zopt[j_k];
                                END_FOR;
                                b_Ac[18] := AcSlack[kDrop] * zopt[18];
                                i0_b_abs(x := b_Ac);
                                temp4 := i0_b_abs.y;
                                temp5 := maximum_MPC(x := temp4);
                                cTol[kDrop] := MAX(IN1:=cTol[kDrop], IN2:=temp5);
                            END_IF;
                            IF  NOT rtb_iAout[kDrop] THEN 
                                t := 0.0;
                                FOR j_k := 0 TO 17 DO 
                                    t := (SINT_TO_REAL(AcS[(72 * j_k) + kDrop]) * zopt[j_k]) + t;
                                END_FOR;
                                t := (AcSlack[kDrop] * zopt[18]) + t;
                                cVal := (t - b_b[kDrop]) / cTol[kDrop];
                                IF cVal < cMin THEN 
                                    cMin := cVal;
                                    tmp := kDrop;
                                END_IF;
                            END_IF;
                        END_FOR;
                        cTolComputed := TRUE;
                        IF (tmp + 1) <= 0 THEN 
                            exitg2 := 1;
                        ELSIF b_i = 10 THEN 
                            b_i := 0;
                            exitg2 := 1;
                        ELSE 
                            REPEAT 
                                exitg1 := 0;
                                IF ((tmp + 1) > 0) AND (b_i <= 10) THEN 
                                    temp1 := FALSE;
                                    IF nA = 0 THEN 
                                        FOR j_k := 0 TO 18 DO 
                                            cMin := 0.0;
                                            FOR D_tmp := 0 TO 17 DO 
                                                cMin := (MPC_3_b_Hinv[(19 * D_tmp) + j_k] * SINT_TO_REAL(AcS[(72 * D_tmp) + tmp]))
                                                     + cMin;
                                            END_FOR;
                                            cMin := (MPC_3_b_Hinv[342 + j_k] * AcSlack[tmp]) + cMin;
                                            z[j_k] := cMin;
                                        END_FOR;
                                        temp1 := TRUE;
                                    ELSE 
                                        kDrop := 1;
                                        FOR j_k := 0 TO 360 DO 
                                            RLinv[j_k] := 0.0;
                                        END_FOR;
                                        w_i := 0;
                                        WHILE w_i <= (nA - 1) DO
                                            iC_0 := iC[w_i];
                                            FOR j_k := 0 TO 18 DO 
                                                b_H_tmp := j_k + (19 * w_i);
                                                RLinv[b_H_tmp] := 0.0;
                                                FOR D_tmp := 0 TO 17 DO 
                                                    RLinv[b_H_tmp] := (SINT_TO_REAL(AcS[((72 * D_tmp) + iC_0) - 1]) * MPC_3_b_Linv[(19 * D_tmp)
                                                         + j_k]) + RLinv[b_H_tmp];
                                                END_FOR;
                                                RLinv[b_H_tmp] := (AcSlack[iC_0 - 1] * MPC_3_b_Linv[342 + j_k]) + RLinv[b_H_tmp];   (* columna 18 *)
                                            END_FOR;
                                            w_i := w_i + 1;
                                        END_WHILE;
                                        i0_qr(b_A := RLinv);
                                                                                                                        w_i := 0;
                                        REPEAT 
                                            exitg4 := 0;
                                            IF w_i <= (nA - 1) THEN 
                                                IF ABS(i0_qr.b_R[(19 * w_i) + w_i]) < 1.0E-12 THEN 
                                                    kDrop := -2;
                                                    exitg4 := 1;
                                                ELSE 
                                                    w_i := w_i + 1;
                                                END_IF;
                                            ELSE 
                                                FOR iSave := 0 TO 18 DO 
                                                    FOR w_i := 0 TO 18 DO 
                                                        cMin := 0.0;
                                                        FOR j_k := 0 TO 18 DO 
                                                            cMin := (MPC_3_b_Linv[(19 * iSave) + j_k] * i0_qr.b_Q[(19 * w_i) + j_k])
                                                                 + cMin;
                                                        END_FOR;
                                                        TL[iSave + (19 * w_i)] := cMin;
                                                    END_FOR;
                                                END_FOR;
                                                FOR j_k := 0 TO 360 DO 
                                                    RLinv[j_k] := 0.0;
                                                END_FOR;
                                                iSave := nA - 1;
                                                WHILE (iSave + 1) > 0 DO
                                                    b_H_tmp := iSave + (19 * iSave);
                                                    RLinv[b_H_tmp] := 1.0;
                                                    w_i := iSave;
                                                    WHILE (w_i + 1) <= nA DO
                                                        j_k := (19 * w_i) + iSave;
                                                        RLinv[j_k] := RLinv[j_k] / i0_qr.b_R[b_H_tmp];
                                                        w_i := w_i + 1;
                                                    END_WHILE;
                                                    IF (iSave + 1) > 1 THEN 
                                                        w_i := 0;
                                                        WHILE w_i <= (iSave - 1) DO
                                                            j_k := iSave;
                                                            WHILE (j_k + 1) <= nA DO
                                                                b_H_tmp := (19 * j_k) + w_i;
                                                                RLinv[b_H_tmp] := RLinv[b_H_tmp] - (i0_qr.b_R[(19 * iSave) + w_i] * RLinv[(19 * j_k)
                                                                     + iSave]);
                                                                j_k := j_k + 1;
                                                            END_WHILE;
                                                            w_i := w_i + 1;
                                                        END_WHILE;
                                                    END_IF;
                                                    iSave := iSave - 1;
                                                END_WHILE;
                                                FOR iSave := 0 TO 18 DO 
                                                    w_i := iSave;
                                                    WHILE (w_i + 1) <= 19 DO
                                                        b_H[iSave + (19 * w_i)] := 0.0;
                                                        j_k := nA;
                                                        WHILE (j_k + 1) <= 19 DO
                                                            b_H_tmp := (19 * w_i) + iSave;
                                                            b_H[b_H_tmp] := b_H[b_H_tmp] - (TL[(19 * j_k) + iSave] * TL[(19 * j_k)
                                                                 + w_i]);
                                                            j_k := j_k + 1;
                                                        END_WHILE;
                                                        b_H[w_i + (19 * iSave)] := b_H[(19 * w_i) + iSave];
                                                        w_i := w_i + 1;
                                                    END_WHILE;
                                                END_FOR;
                                                iSave := 0;
                                                WHILE iSave <= (nA - 1) DO
                                                    FOR j_k := 0 TO 18 DO 
                                                        b_D[j_k + (19 * iSave)] := 0.0;
                                                        w_i := iSave;
                                                        WHILE (w_i + 1) <= nA DO
                                                            b_H_tmp := (19 * iSave) + j_k;
                                                            b_D[b_H_tmp] := (TL[(19 * w_i) + j_k] * RLinv[(19 * w_i) + iSave])
                                                                 + b_D[b_H_tmp];
                                                            w_i := w_i + 1;
                                                        END_WHILE;
                                                    END_FOR;
                                                    iSave := iSave + 1;
                                                END_WHILE;
                                                exitg4 := 1;
                                            END_IF;
                                        UNTIL NOT(exitg4 = 0)
                                        END_REPEAT;
                                        IF kDrop <= 0 THEN 
                                            b_i := -2;
                                            exitg1 := 1;
                                        ELSE 
                                            FOR j_k := 0 TO 18 DO 
                                                cMin := 0.0;
                                                FOR D_tmp := 0 TO 17 DO 
                                                    cMin := (( -b_H[(19 * D_tmp) + j_k]) * SINT_TO_REAL(AcS[(72 * D_tmp) + tmp])) + cMin;
                                                END_FOR;
                                                cMin := (( -b_H[342 + j_k]) * AcSlack[tmp]) + cMin;
                                                z[j_k] := cMin;
                                            END_FOR;
                                            kDrop := 0;
                                            WHILE kDrop <= (nA - 1) DO
                                                t := 0.0;
                                                FOR j_k := 0 TO 17 DO 
                                                    t := (SINT_TO_REAL(AcS[(72 * j_k) + tmp]) * b_D[(19 * kDrop) + j_k]) + t;
                                                END_FOR;
                                                t := (AcSlack[tmp] * b_D[(19 * kDrop) + 18]) + t;
                                                b_r[kDrop] := t;
                                                kDrop := kDrop + 1;
                                            END_WHILE;
                                            temp1 := TRUE;
                                        END_IF;
                                    END_IF;
                                    IF temp1 THEN 
                                        kDrop := 0;
                                        cMin := 0.0;
                                        DualFeasible := TRUE;
                                        ColdReset := TRUE;
                                        IF nA > 0 THEN 
                                            iSave := 0;
                                            REPEAT 
                                                exitg4 := 0;
                                                IF iSave <= (nA - 1) THEN 
                                                    IF b_r[iSave] >= 1.0E-12 THEN 
                                                        ColdReset := FALSE;
                                                        exitg4 := 1;
                                                    ELSE 
                                                        iSave := iSave + 1;
                                                    END_IF;
                                                ELSE 
                                                    exitg4 := 1;
                                                END_IF;
                                            UNTIL NOT(exitg4 = 0)
                                            END_REPEAT;
                                        END_IF;
                                        IF (nA <> 0) AND ( NOT ColdReset) THEN 
                                            w_i := 0;
                                            WHILE w_i <= (nA - 1) DO
                                                IF b_r[w_i] > 1.0E-12 THEN 
                                                    cVal := aZZ1[iC[w_i] - 1] / b_r[w_i];
                                                    IF (kDrop = 0) OR (cVal < rMin) THEN 
                                                        rMin := cVal;
                                                        kDrop := w_i + 1;
                                                    END_IF;
                                                END_IF;
                                                w_i := w_i + 1;
                                            END_WHILE;
                                            IF kDrop > 0 THEN 
                                                cMin := rMin;
                                                DualFeasible := FALSE;
                                            END_IF;
                                        END_IF;
                                        FOR j_k := 0 TO 17 DO 
                                            b_Ac[j_k] := SINT_TO_REAL(AcS[(72 * j_k) + tmp]);
                                        END_FOR;
                                        b_Ac[18] := AcSlack[tmp];
                                        cVal := mtimes_MPC(b_A := z, B := b_Ac);
                                        IF cVal <= 0.0 THEN 
                                            cVal := 0.0;
                                            ColdReset := TRUE;
                                        ELSE 
                                            t := 0.0;
                                            FOR j_k := 0 TO 17 DO 
                                                t := (SINT_TO_REAL(AcS[(72 * j_k) + tmp]) * zopt[j_k]) + t;
                                            END_FOR;
                                            t := (AcSlack[tmp] * zopt[18]) + t;
                                            cVal := (b_b[tmp] - t) / cVal;
                                            ColdReset := FALSE;
                                        END_IF;
                                        IF DualFeasible AND ColdReset THEN 
                                            b_i := -1;
                                            exitg1 := 1;
                                        ELSE 
                                            IF ColdReset THEN 
                                                t := cMin;
                                            ELSIF DualFeasible THEN 
                                                t := cVal;
                                            ELSIF cMin < cVal THEN 
                                                t := cMin;
                                            ELSE 
                                                t := cVal;
                                            END_IF;
                                            w_i := 0;
                                            WHILE w_i <= (nA - 1) DO
                                                aZZ1[iC[w_i] - 1] := aZZ1[iC[w_i] - 1] - (t * b_r[w_i]);
                                                IF iC[w_i] <= 72 THEN 
                                                    IF aZZ1[iC[w_i] - 1] < 0.0 THEN 
                                                        aZZ1[iC[w_i] - 1] := 0.0;
                                                    END_IF;
                                                END_IF;
                                                w_i := w_i + 1;
                                            END_WHILE;
                                            aZZ1[tmp] := aZZ1[tmp] + t;
                                            IF ABS(t - cMin) < 2.2204460492503131E-16 THEN 
                                                i0_DropConstraint(kDrop := kDrop, iA := rtb_iAout, nA := nA, iC := iC);
                                            END_IF;
                                            IF  NOT ColdReset THEN 
                                                FOR j_k := 0 TO 18 DO 
                                                    zopt[j_k] := (t * z[j_k]) + zopt[j_k];
                                                END_FOR;
                                                IF ABS(t - cVal) < 2.2204460492503131E-16 THEN 
                                                    IF nA = 19 THEN 
                                                        b_i := -1;
                                                        exitg1 := 1;
                                                    ELSE 
                                                        nA := nA + 1;
                                                        iC[nA - 1] := tmp + 1;
                                                        kDrop := nA - 1;
                                                        REPEAT 
                                                            exitg4 := 0;
                                                            IF (kDrop + 1) > 1 THEN 
                                                                j_k := iC[kDrop - 1];
                                                                IF iC[kDrop] > j_k THEN 
                                                                    exitg4 := 1;
                                                                ELSE 
                                                                    iSave := iC[kDrop];
                                                                    iC[kDrop] := j_k;
                                                                    iC[kDrop - 1] := iSave;
                                                                    kDrop := kDrop - 1;
                                                                END_IF;
                                                            ELSE 
                                                                exitg4 := 1;
                                                            END_IF;
                                                        UNTIL NOT(exitg4 = 0)
                                                        END_REPEAT;
                                                        rtb_iAout[tmp] := TRUE;
                                                        tmp := -1;
                                                        b_i := b_i + 1;
                                                    END_IF;
                                                ELSE 
                                                    b_i := b_i + 1;
                                                END_IF;
                                            ELSE 
                                                b_i := b_i + 1;
                                            END_IF;
                                        END_IF;
                                    END_IF;
                                ELSE 
                                    cMin := b_norm_MPC(x := zopt);
                                    IF ABS(cMin - Xnorm0) > 0.001 THEN 
                                        Xnorm0 := cMin;
                                        i0_abs_g(x := b_b);
                                        temp6 := i0_abs_g.y;
                                        i0_maximum2(x := temp6, y := 1.0);
                                        cTol := i0_maximum2.ex;
                                        cTolComputed := FALSE;
                                    END_IF;
                                    exitg1 := 2;
                                END_IF;
                            UNTIL NOT(exitg1 = 0)
                            END_REPEAT;
                            IF exitg1 = 1 THEN 
                                exitg2 := 1;
                            END_IF;
                        END_IF;
                    ELSE 
                        exitg2 := 1;
                    END_IF;
                UNTIL NOT(exitg2 = 0)
                END_REPEAT;
            END_IF;
            (* [DIAG] Estado del QP (solver KWIK), segun el codigo generado:              *)
            (*   1..10 : solucion optima (contador de iteraciones)                        *)
            (*   0     : agoto las 10 iteraciones -> solucion suboptima + mpc_clipping      *)
            (*   > 10  : agoto las iteraciones por otra ruta del bucle y sale sin marcar 0; *)
            (*           el codigo la aplica sin mpc_clipping                             *)
            (*   < 0   : problema infactible -> se retiene la MV anterior                 *)
            "Diag_HIL".mpc_qp_estado := b_i;
            IF b_i < 0 THEN
                "Diag_HIL".mpc_n_infactible := "Diag_HIL".mpc_n_infactible + 1;
            ELSE
                IF (b_i = 0) OR (b_i > 10) THEN
                    "Diag_HIL".mpc_n_tope := "Diag_HIL".mpc_n_tope + 1;
                END_IF;
                "Diag_HIL".mpc_iter_max := MAX(IN1 := "Diag_HIL".mpc_iter_max, IN2 := b_i);
            END_IF;
            
            IF b_i < 0 THEN 
                FOR kDrop := 0 TO 18 DO 
                    zopt[kDrop] := 0.0;
                END_FOR;
            END_IF;
            mv[0] := ((last_mv_DSTATE[0] - 0.656128124791873) + zopt[0]) + 0.656128124791873;
            mv[1] := ((last_mv_DSTATE[1] - 0.237985602615591) + zopt[1]) + 0.237985602615591;
            mv[2] := ((last_mv_DSTATE[2] - 0.474364026109265) + zopt[2]) + 0.474364026109265;
            IF b_i = 0 THEN 
                old_u[0] := (last_mv_DSTATE[0] - 0.656128124791873) + 0.656128124791873;
                old_u[1] := (last_mv_DSTATE[1] - 0.237985602615591) + 0.237985602615591;
                old_u[2] := (last_mv_DSTATE[2] - 0.474364026109265) + 0.474364026109265;
                i0_mpc_clipping(uk := mv, uk1 := old_u, b_uoff := MPC_3_b_uoff, b_Mlim := MPC_3_b_Mlim, b_Mrows := MPC_3_b_Mrows, 
                    b_ny := 3, b_degrees := 19);
                mv := i0_mpc_clipping.uk_clipped;
            END_IF;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* '<S24>:1:231' if return_xseq || return_ovseq *)
            (* '<S24>:1:233' else *)
            (* '<S24>:1:234' yseq = zeros(p+1,ny,'like',rseq); *)
            (* '<S24>:1:235' xseq = zeros(p+1,nxQP,'like',rseq); *)
            (* '<S24>:1:238' if CustomEstimation *)
            (* '<S24>:1:240' else *)
            (* update x[k+1|k], assuming that above u and v will be applied. *)
            (* '<S24>:1:242' xk1 = A*xk + Bu*(u - uoff) + Bv*v + L*y_innov; *)
            (* '<S24>:1:244' xk1 = xk1 + xoff; *)
            (* Updated state must include offset *)
            (* return xest in original value *)
            (* '<S24>:1:247' xest = xest + xoff; *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            (* Update for Memory: '<S3>/Memory' *)
            FOR kDrop := 0 TO 71 DO 
                Memory_PreviousInput[kDrop] := rtb_iAout[kDrop];
            END_FOR;
            (* End of Update for Memory: '<S3>/Memory' *)
            
            (* Update for UnitDelay: '<S3>/last_mv' *)
            last_mv_DSTATE[0] := mv[0];
            (* MATLAB Function: '<S23>/optimizer' incorporates:
             *  UnitDelay: '<S3>/last_mv' *)
            rMin := mv[0] - 0.656128124791873;
            (* Update for UnitDelay: '<S3>/last_mv' *)
            last_mv_DSTATE[1] := mv[1];
            (* MATLAB Function: '<S23>/optimizer' incorporates:
             *  UnitDelay: '<S3>/last_mv' *)
            Xnorm0 := mv[1] - 0.237985602615591;
            (* Update for UnitDelay: '<S3>/last_mv' *)
            cMin := mv[2];
            last_mv_DSTATE[2] := mv[2];
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            (* Outputs for Atomic SubSystem: '<Root>/MPC_3' *)
            FOR j_k := 0 TO 6 DO 
                (* MATLAB Function: '<S23>/optimizer' *)
                cVal := 0.0;
                FOR D_tmp := 0 TO 6 DO 
                    cVal := (MPC_3_e_a[(7 * D_tmp) + j_k] * xk[D_tmp]) + cVal;
                END_FOR;
                (* Update for Memory: '<S3>/last_x' incorporates:
                 *  MATLAB Function: '<S23>/optimizer' *)
                last_x_PreviousInput[j_k] := (((((MPC_3_f_a[j_k + 7] * Xnorm0) + (MPC_3_f_a[j_k] * rMin)) + (MPC_3_f_a[j_k + 14] * (cMin - 0.474364026109265)
                    )) + cVal) + (((MPC_3_g_a[j_k + 7] * y_innov[1]) + (MPC_3_g_a[j_k] * y_innov[0])) + (MPC_3_g_a[j_k + 14] * y_innov[2])
                    )) + MPC_3_b_xoff[j_k];
            END_FOR;
            (* End of Outputs for SubSystem: '<Root>/MPC_3' *)
            
            (* [DIAG] fin de la medicion: tiempo de esta ejecucion en ms *)
            "Diag_HIL".mpc_ms := RUNTIME("Diag_HIL".mpc_mem) * 1000.0;
            
            (* [DIAG] reinicio de estadisticas desde la tabla de observacion *)
            IF "Diag_HIL".mpc_reset THEN
                "Diag_HIL".mpc_n := 0;
                "Diag_HIL".mpc_sum_ms := 0.0;
                "Diag_HIL".mpc_max_ms := 0.0;
                "Diag_HIL".mpc_iter_max := 0;
                "Diag_HIL".mpc_n_tope := 0;
                "Diag_HIL".mpc_n_infactible := 0;
                "Diag_HIL".mpc_reset := FALSE;
            END_IF;
            
            (* [DIAG] promedio y maximo desde el ultimo reset *)
            (* [DIAG] Si el contador interno de RUNTIME da la vuelta, la medicion sale <= 0.0 y
               Siemens indica descartarla: solo se acumulan mediciones positivas. *)
            IF "Diag_HIL".mpc_ms > 0.0 THEN
                "Diag_HIL".mpc_n := "Diag_HIL".mpc_n + 1;
                "Diag_HIL".mpc_sum_ms := "Diag_HIL".mpc_sum_ms + "Diag_HIL".mpc_ms;
                "Diag_HIL".mpc_prom_ms := "Diag_HIL".mpc_sum_ms / DINT_TO_LREAL("Diag_HIL".mpc_n);
                "Diag_HIL".mpc_max_ms := MAX(IN1 := "Diag_HIL".mpc_max_ms, IN2 := "Diag_HIL".mpc_ms);
            END_IF;
        END_IF;
        IF PLCGlobalVarMPC.plc_ts_counter_MPC >= 0 THEN   (* divisor desactivado: OB de 100 ms *) 
            PLCGlobalVarMPC.plc_ts_counter_MPC := 0;
        ELSE 
            PLCGlobalVarMPC.plc_ts_counter_MPC := PLCGlobalVarMPC.plc_ts_counter_MPC + 1;
        END_IF;
END_CASE;
END_FUNCTION_BLOCK
