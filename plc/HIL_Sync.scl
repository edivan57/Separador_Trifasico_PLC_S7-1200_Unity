
FUNCTION_BLOCK "HIL_Sync"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
   VAR_INPUT
      Inicio : Bool;                 // TRUE al inicio del OB, FALSE al final
      Activo : Bool;                 // controlador de este OB activo
      Metodo_Sync : Int;             // "Data".Metodo_Sync
      Ciclos_Watchdog : Int := 10;   // 10 ciclos de 100 ms = 1 s sin medicion nueva
   END_VAR
   VAR_OUTPUT
      Ejecutar_Control : Bool;       // llamar al controlador con ssMethodType := 1
      Reiniciar : Bool;              // llamar con ssMethodType := 0 y poner Cv_ en cero
   END_VAR
   VAR_IN_OUT
      Contador_PLC : DInt;
      Seq_Unity : DInt;
      Eco_Seq : DInt;
      Falla_Com : Bool;
   END_VAR
   VAR
      Seq_Anterior : DInt;
      Ciclos_Sin_Cambio : Int;
      Activo_Anterior : Bool;
      Inicializado : Bool;
   END_VAR

BEGIN
   IF #Inicio THEN
      #Reiniciar := NOT #Activo AND (#Activo_Anterior OR NOT #Inicializado);
      #Inicializado := TRUE;
      #Activo_Anterior := #Activo;

      IF #Activo THEN
         // Copiar Seq_Unity ANTES que las PV: Unity escribe primero las PV y
         // luego Seq_Unity, asi la PV usada nunca es mas vieja que Eco_Seq.
         #Eco_Seq := #Seq_Unity;

         IF #Seq_Unity = #Seq_Anterior THEN
            IF #Ciclos_Sin_Cambio < 32767 THEN
               #Ciclos_Sin_Cambio := #Ciclos_Sin_Cambio + 1;
            END_IF;
         ELSE
            #Ciclos_Sin_Cambio := 0;
         END_IF;
         #Seq_Anterior := #Seq_Unity;

         #Falla_Com := (#Metodo_Sync = 1) AND (#Ciclos_Sin_Cambio >= #Ciclos_Watchdog);
         #Ejecutar_Control := NOT #Falla_Com;
      ELSE
         #Ejecutar_Control := FALSE;
         #Ciclos_Sin_Cambio := 0;
         IF #Reiniciar THEN
            #Falla_Com := FALSE;     // se limpia una sola vez, al desactivarse
         END_IF;
      END_IF;
   ELSE
      // Final del OB, despues de escribir Cv_: anuncia una accion nueva.
      IF #Activo THEN
         #Contador_PLC := #Contador_PLC + 1;
      END_IF;
   END_IF;
END_FUNCTION_BLOCK
