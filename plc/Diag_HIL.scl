
DATA_BLOCK Diag_HIL
STRUCT
    (* OB ciclico completo *)
    ob_mem: LREAL;
    ob_aux: LREAL;
    ob_ms: LREAL;
    ob_max_ms: LREAL;
    eventos_perdidos: DINT;
    ob_reset: BOOL;
    (* PID *)
    pid_mem: LREAL;
    pid_aux: LREAL;
    pid_ms: LREAL;
    pid_prom_ms: LREAL;
    pid_max_ms: LREAL;
    pid_sum_ms: LREAL;
    pid_n: DINT;
    pid_reset: BOOL;
    (* Fuzzy *)
    fuzzy_mem: LREAL;
    fuzzy_aux: LREAL;
    fuzzy_ms: LREAL;
    fuzzy_prom_ms: LREAL;
    fuzzy_max_ms: LREAL;
    fuzzy_sum_ms: LREAL;
    fuzzy_n: DINT;
    fuzzy_reset: BOOL;
    (* MPC *)
    mpc_mem: LREAL;
    mpc_aux: LREAL;
    mpc_ms: LREAL;
    mpc_prom_ms: LREAL;
    mpc_max_ms: LREAL;
    mpc_sum_ms: LREAL;
    mpc_n: DINT;
    mpc_qp_estado: DINT;      (* ultimo estado del QP: >0 optimo, 0 tope, <0 infactible *)
    mpc_iter_max: DINT;       (* maximo del contador de iteraciones en soluciones optimas *)
    mpc_n_tope: DINT;         (* ejecuciones que llegaron al tope de 10 iteraciones *)
    mpc_n_infactible: DINT;   (* ejecuciones con QP infactible *)
    mpc_reset: BOOL;
END_STRUCT
BEGIN
END_DATA_BLOCK
